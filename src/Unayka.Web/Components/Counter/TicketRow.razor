@using Unayka.Core.Counter

<li class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
    <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium text-ink">@Text(Line.Name)</p>
        <p class="text-xs text-muted">@Text(_unitPrice)</p>
    </div>
    <div class="flex items-center gap-1">
        <button type="button" @onclick="Decrease" class="h-9 w-9 rounded-full border border-border text-lg text-accent-strong transition hover:border-accent" aria-label="@DecreaseLabel">@Text(DecreaseSymbol)</button>
        <span class="w-8 text-center text-sm">@Text(_quantity)</span>
        <button type="button" @onclick="Increase" class="h-9 w-9 rounded-full border border-border text-lg text-accent-strong transition hover:border-accent" aria-label="@IncreaseLabel">@Text(IncreaseSymbol)</button>
    </div>
    <p class="w-24 text-right text-sm font-medium">@Text(_total)</p>
    <button type="button" @onclick="Remove" class="h-9 w-9 rounded-full text-muted transition hover:bg-accent-soft hover:text-danger" aria-label="@RemoveLabel">@Text(RemoveSymbol)</button>
</li>

@code {
    private const string DecreaseLabel = "Diminuir quantidade";
    private const string IncreaseLabel = "Aumentar quantidade";
    private const string RemoveLabel = "Remover linha";
    private const string DecreaseSymbol = "−";
    private const string IncreaseSymbol = "+";
    private const string RemoveSymbol = "×";

    [Parameter, EditorRequired]
    public TicketLine Line { get; set; } = default!;

    [Parameter]
    public int Index { get; set; }

    [Parameter]
    public EventCallback<(int Index, int Delta)> OnChange { get; set; }

    [Parameter]
    public EventCallback<int> OnRemove { get; set; }

    private string _unitPrice = string.Empty;
    private string _quantity = string.Empty;
    private string _total = string.Empty;

    protected override void OnParametersSet()
    {
        _unitPrice = FormatMoney(Line.UnitPriceMinor);
        _quantity = Line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _total = FormatMoney(Line.TotalMinor);
    }

    private Task Decrease() => OnChange.InvokeAsync((Index, -1));

    private Task Increase() => OnChange.InvokeAsync((Index, 1));

    private Task Remove() => OnRemove.InvokeAsync(Index);
}
