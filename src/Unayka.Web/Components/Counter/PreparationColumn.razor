@using Unayka.Core.Counter

<section class="flex min-h-64 flex-col rounded-3xl bg-paper p-4 shadow-sm">
    <header class="mb-4 flex items-center justify-between px-1">
        <h2 class="font-serif text-2xl text-espresso">@Text(Title)</h2>
        <span class="rounded-full bg-cream px-3 py-1 text-xs text-stone">@Text(_count)</span>
    </header>

    <div class="space-y-3">
        @foreach (var card in _cards)
        {
            <article class="rounded-2xl border border-sand p-4 transition hover:border-clay">
                <div class="flex items-start justify-between gap-2">
                    <p class="font-serif text-xl text-espresso">@Text(card.Number)</p>
                    <span class="@card.ChannelClass">@Text(card.ChannelLabel)</span>
                </div>
                <p class="mt-1 text-sm text-stone">@Text(card.Customer)</p>
                <ul class="mt-3 space-y-1 text-sm text-ink">
                    @foreach (var item in card.Items)
                    {
                        <li>@Text(item)</li>
                    }
                </ul>
                <div class="mt-4 flex items-center justify-between gap-2">
                    <span class="@card.AgeClass">@Text(card.Age)</span>
                    @if (card.CanAdvance)
                    {
                        <button type="button" @onclick="card.Advance" class="rounded-full bg-espresso px-4 py-2 text-xs text-paper transition hover:bg-clay">@Text(AdvanceLabel)</button>
                    }
                </div>
            </article>
        }
        @if (_cards.Count == 0)
        {
            <p class="px-1 py-6 text-center font-script text-2xl text-stone">@Text(EmptyMessage)</p>
        }
    </div>
</section>

@code {
    private const string EmptyMessage = "Sem pedidos";
    private const string AdvanceLabel = "Avançar";
    private const string CounterLabel = "Balcão";
    private const string OnlineLabel = "Online";
    private const string AgeFormat = "há {0} min";
    private const int LateAfterMinutes = 10;
    private const string ChannelBase = "rounded-full px-3 py-1 text-xs ";
    private const string CounterClass = ChannelBase + "bg-sage-soft text-sage";
    private const string OnlineClass = ChannelBase + "bg-rose-soft text-clay";
    private const string AgeNormalClass = "text-xs text-stone";
    private const string AgeLateClass = "text-xs font-medium text-red-700";

    private sealed record CardView(
        string Number,
        string Customer,
        string ChannelLabel,
        string ChannelClass,
        IReadOnlyList<string> Items,
        string Age,
        string AgeClass,
        bool CanAdvance,
        Func<Task> Advance);

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<PreparationCard> Cards { get; set; } = [];

    [Parameter]
    public EventCallback<int> OnAdvance { get; set; }

    private List<CardView> _cards = [];
    private string _count = string.Empty;

    protected override void OnParametersSet()
    {
        _count = Cards.Count.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _cards = Cards.Select(ToView).ToList();
    }

    private CardView ToView(PreparationCard card)
    {
        var isCounter = card.Channel == OrderChannel.Counter;
        var isLate = card.AgeMinutes >= LateAfterMinutes && PreparationFlow.Next(card.Status) is not null && card.Status != OrderStatus.Ready;
        return new CardView(
            card.Number,
            card.CustomerName,
            isCounter ? CounterLabel : OnlineLabel,
            isCounter ? CounterClass : OnlineClass,
            card.Items,
            string.Format(System.Globalization.CultureInfo.InvariantCulture, AgeFormat, card.AgeMinutes),
            isLate ? AgeLateClass : AgeNormalClass,
            PreparationFlow.Next(card.Status) is not null,
            () => OnAdvance.InvokeAsync(card.OrderId));
    }
}
