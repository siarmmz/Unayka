<article class="group flex h-full flex-col">
    <a href="@_url" class="block">
        <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-cream">
            <img src="@_imageUrl" alt="@Model.Name" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-105"/>
            @if (Model.Badge is not null)
            {
                <span class="absolute left-3 top-3 rounded-full bg-paper/90 px-3 py-1 text-xs font-medium tracking-wide text-espresso">@Text(Model.Badge)</span>
            }
        </div>
        <div class="mt-4 space-y-1">
            <p class="text-xs uppercase tracking-widest text-stone">@Text(Model.CategoryName)</p>
            <h3 class="font-serif text-xl text-espresso transition group-hover:text-clay">@Text(Model.Name)</h3>
            <PriceTag PriceMinor="Model.PriceMinor" CompareAtPriceMinor="Model.CompareAtPriceMinor"/>
        </div>
    </a>
    <form method="post" action="@AddAction" class="mt-auto pt-4">
        <AntiforgeryToken/>
        <input type="hidden" name="ProductId" value="@Model.Id"/>
        <input type="hidden" name="ReturnUrl" value="@_returnUrl"/>
        <button type="submit" disabled="@_soldOut" class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-espresso">@Text(_addLabel)</button>
    </form>
</article>

@code {
    private const string AddAction = "/carrinho/adicionar";
    private const string AddLabel = "Adicionar";
    private const string SoldOutLabel = "Esgotado";

    [Parameter, EditorRequired]
    public ProductCardModel Model { get; set; } = null!;

    private string _url = string.Empty;
    private string _imageUrl = string.Empty;
    private string _returnUrl = string.Empty;
    private string _addLabel = AddLabel;
    private bool _soldOut;

    protected override void OnParametersSet()
    {
        _url = ToUrl(StoreUrls.Product(Model.Slug));
        _imageUrl = ToUrl(Model.ImageUrl);
        _returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        _soldOut = !Model.InStock;
        _addLabel = _soldOut ? SoldOutLabel : AddLabel;
    }
}
