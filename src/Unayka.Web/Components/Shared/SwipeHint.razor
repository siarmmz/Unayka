<div aria-hidden="true" class="@_class">
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-surface/90 text-accent-strong shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 animate-swipe-nudge" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/></svg>
    </span>
</div>

@code {
    private const string BaseClass = "pointer-events-none absolute z-20 flex opacity-0 transition-opacity duration-500 animate-swipe-hint group-hover/swipe:animate-none group-hover/swipe:opacity-100 motion-reduce:hidden";

    [Parameter, EditorRequired]
    public string Position { get; set; } = string.Empty;

    private string _class = BaseClass;

    protected override void OnParametersSet() => _class = $"{BaseClass} {Position}";
}
