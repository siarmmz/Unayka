@page "/contact"

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<PageHero Title="@Data.Title" Eyebrow="@Data.Eyebrow" Subtitle="@Data.Subtitle" ImageUrl="@Data.HeroImage"/>

<section class="container-page py-20">
    <div class="grid gap-6 md:grid-cols-3">
        @foreach (var channel in Data.Channels)
        {
            <div class="rounded-3xl bg-cream p-8 text-center">
                <p class="font-script text-3xl text-clay">@Text(channel.Title)</p>
                <p class="mt-3 text-espresso">@Text(channel.Value)</p>
            </div>
        }
    </div>

    <p class="mx-auto mt-12 max-w-xl text-center text-stone">@Text(Data.Note)</p>
    <div class="mt-8 text-center">
        <a href="@ToUrl(Data.LocationUrl)" class="btn-outline">@Text(Data.LocationLabel)</a>
    </div>
</section>

@code {
    private static readonly (string Title, string Eyebrow, string Subtitle, string HeroImage, string Note, string LocationLabel, string LocationUrl, (string Title, string Value)[] Channels, (string Title, string Description) Seo) Data = (
        "Contacto",
        "Fale connosco",
        "Teremos prazer em ouvir a sua mensagem.",
        SiteImages.ContactUrl,
        "Os canais de contacto da loja serão publicados aqui muito em breve. Até lá, passe pelo balcão ou faça o seu pedido online.",
        "Ver localização",
        "/location",
        [
            ("Telemóvel", "Em breve"),
            ("Email", "Em breve"),
            ("Balcão", "Avenida 24 de Julho, Maputo"),
        ],
        ("Contacto | Unayka", "Fale com a Unayka.")
    );
}
