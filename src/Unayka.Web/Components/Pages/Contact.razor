@page "/contacto"
@using Unayka.Core.Locations
@using Unayka.Web.Components.Locations
@inject ILocationDirectory Locations

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<PageHero Title="@Data.Title" Eyebrow="@Data.Eyebrow" Subtitle="@Data.Subtitle" ImageUrl="@Data.HeroImage"/>

<section class="container-page py-12 lg:py-20">
    @if (_locations.Count == 0)
    {
        <EmptyState Title="@Data.EmptyTitle" Message="@Data.EmptyMessage" ActionLabel="@Data.ShopLabel" ActionUrl="@Data.ShopUrl"/>
    }

    <div class="grid gap-8 lg:grid-cols-2">
        @foreach (var location in _locations)
        {
            <LocationCard Location="location"/>
        }
    </div>
</section>

@code {
    private static readonly (string Title, string Eyebrow, string Subtitle, string HeroImage, string EmptyTitle, string EmptyMessage, string ShopLabel, string ShopUrl, (string Title, string Description) Seo) Data = (
        "Contacto",
        "Fale connosco",
        "Escolha a loja mais perto de si e fale connosco.",
        SiteImages.ContactUrl,
        "Contactos em breve",
        "Os contactos das lojas serão publicados aqui muito em breve.",
        "Ver a loja",
        StoreUrls.Shop,
        ("Contacto | Unayka", "Contactos, morada, horário e mapa de cada loja Unayka.")
    );

    private IReadOnlyList<LocationSummary> _locations = [];

    protected override async Task OnInitializedAsync()
    {
        _locations = await Locations.ActiveAsync();
    }
}
