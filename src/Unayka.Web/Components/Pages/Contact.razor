@page "/contacto"
@using Unayka.Core.Locations
@inject ILocationDirectory Locations
@inject ISiteContent Site

<SeoComponent Title="@_seo.Title" Description="@_seo.Body"/>

<section class="relative isolate overflow-hidden bg-surface-alt">
    <img src="@_heroImage" alt="" class="absolute inset-0 -z-20 h-full w-full object-cover"/>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-surface via-surface/85 to-surface/30"></div>
    <div class="container-page py-20 md:py-28">
        <p class="font-script text-3xl text-accent">@Text(_hero.Eyebrow)</p>
        <h1 class="max-w-2xl font-serif text-4xl leading-tight text-accent-strong md:text-6xl">@Text(_hero.Title)</h1>
        <p class="mt-5 max-w-xl text-lg text-ink">@Text(_hero.Body)</p>
    </div>
</section>

<section class="container-page py-12 lg:py-20">
    @if (_locations.Count == 0)
    {
        <div class="mx-auto max-w-md rounded-3xl border border-border bg-surface-alt px-8 py-14 text-center">
            <p class="font-script text-3xl text-accent">@Text(EmptyTitle)</p>
            <p class="mt-3 text-muted">@Text(EmptyMessage)</p>
            <a href="@ShopUrl" class="btn-primary mt-8">@Text(ShopLabel)</a>
        </div>
    }

    <div class="grid gap-8 lg:grid-cols-2">
        @foreach (var location in _locations)
        {
            <article class="space-y-6 rounded-3xl border border-border bg-surface p-6 sm:p-8">
                <div class="space-y-2">
                    <h2 class="font-serif text-3xl text-accent-strong">@Text(location.Name)</h2>
                    <p class="flex items-start gap-2 text-ink"><i class="bi bi-geo-alt mt-0.5 text-accent"></i>@Text(location.Address)</p>
                    <p class="flex items-start gap-2 text-sm text-muted"><i class="bi bi-clock mt-0.5 text-accent"></i>@Text(location.Hours)</p>
                </div>
                <ul class="grid gap-3 sm:grid-cols-2">
                    @foreach (var contact in location.Contacts)
                    {
                        <li>
                            <a href="@contact.Href" class="flex min-h-12 items-center gap-3 rounded-2xl bg-surface-alt px-4 py-2 transition hover:bg-success-soft">
                                <i class="bi @contact.Icon text-xl text-accent"></i>
                                <span class="flex flex-col">
                                    <span class="text-xs font-medium uppercase tracking-widest text-muted">@Text(contact.Label)</span>
                                    <span class="break-all text-accent-strong">@Text(contact.Value)</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
                @if (location.MapUrl is not null)
                {
                    <iframe src="@location.MapUrl" title="@location.MapTitle" loading="lazy" referrerpolicy="no-referrer" class="h-64 w-full rounded-2xl border border-border md:h-80"></iframe>
                }
            </article>
        }
    </div>
</section>

@code {
    private const string EmptyTitle = "Contactos em breve";
    private const string EmptyMessage = "Os contactos das lojas serão publicados aqui muito em breve.";
    private const string ShopLabel = "Ver a loja";
    private const string HoursPrefix = "Horário: ";
    private const string MapTitlePrefix = "Mapa de ";
    private static readonly string ShopUrl = ToUrl(StoreUrls.Shop);

    private SiteBlockView _seo = new SitePage([]).One(SitePlacements.Seo);
    private SiteBlockView _hero = new SitePage([]).One(SitePlacements.Hero);
    private string _heroImage = string.Empty;
    private List<(string Name, string Address, string Hours, IReadOnlyList<LocationContactSummary> Contacts, string? MapUrl, string MapTitle)> _locations = [];

    protected override async Task OnInitializedAsync()
    {
        var page = await Site.PageAsync(SitePages.Contact);
        _seo = page.One(SitePlacements.Seo);
        _hero = page.One(SitePlacements.Hero);
        _heroImage = ToUrl(_hero.ImageUrl);
        _locations = (await Locations.ActiveAsync())
            .Select(location => (location.Name, location.Address, HoursPrefix + location.OpeningHours, location.Contacts, location.SafeMapUrl, MapTitlePrefix + location.Name))
            .ToList();
    }
}
