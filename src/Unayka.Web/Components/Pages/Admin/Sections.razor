@page "/admin/seccoes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = UnaykaPolicies.Management)]
@inject IAdminTaxonomy Taxonomy

<PageTitle>@Texts.PageTitle</PageTitle>

<div class="mx-auto max-w-6xl space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="font-script text-2xl text-accent">@Text(Texts.Eyebrow)</p>
            <h1 class="font-serif text-4xl text-accent-strong sm:text-5xl">@Text(Texts.Title)</h1>
            <p class="mt-2 max-w-2xl text-sm text-muted">@Text(Texts.Subtitle)</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn-primary px-6 py-2" @onclick="StartNew">@Text(Texts.NewLabel)</button>
        </div>
    </header>

    @if (_form is not null)
    {
        <form class="space-y-5 rounded-2xl border border-border bg-surface p-5 shadow-sm sm:p-8" @onsubmit="SaveAsync">
            <h2 class="font-serif text-2xl">@Text(_formTitle)</h2>
            @if (_errors.Count > 0)
            {
                <div role="alert" class="space-y-1 rounded-xl bg-accent-soft px-4 py-3 text-sm text-danger">
                    @foreach (var errorMessage in _errors)
                    {
                        <p>@Text(errorMessage)</p>
                    }
                </div>
            }
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label for="section-name" class="field-label">@Text(Texts.NameLabel)</label>
                    <input id="section-name" type="text" maxlength="80" class="field" @bind="_form.Name" @bind:event="oninput" @bind:after="OnNameChanged"/>
                </div>
                <div>
                    <label for="section-slug" class="field-label">@Text(Texts.SlugLabel)</label>
                    <input id="section-slug" type="text" maxlength="80" class="field" @bind="_form.Slug" @bind:after="OnSlugEdited"/>
                </div>
                <div>
                    <label for="section-status" class="field-label">@Text(Texts.StatusLabel)</label>
                    <select id="section-status" class="field" @bind="_form.Status">
                        @foreach (var option in CatalogStatuses)
                        {
                            <option value="@option.Value">@Text(option.Label)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="section-order" class="field-label">@Text(Texts.OrderLabel)</label>
                    <input id="section-order" type="number" step="1" class="field" @bind="_form.SortOrder"/>
                </div>
                <div class="sm:col-span-2">
                    <label for="section-image" class="field-label">@Text(Texts.ImageLabel)</label>
                    <input id="section-image" type="url" class="field" @bind="_form.ImageUrl"/>
                </div>
                <div class="sm:col-span-2">
                    <label for="section-description" class="field-label">@Text(Texts.DescriptionLabel)</label>
                    <textarea id="section-description" rows="3" class="field" @bind="_form.Description"></textarea>
                </div>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="btn-primary px-8">@Text(Texts.Save)</button>
                <button type="button" class="btn-outline px-8" @onclick="CancelEdit">@Text(Texts.Cancel)</button>
            </div>
        </form>
    }

    @if (_notice is not null)
    {
        <p class="rounded-xl bg-success-soft px-4 py-3 text-sm text-accent-strong">@Text(_notice)</p>
    }

    @if (_actionErrors.Count > 0)
    {
        <div role="alert" class="space-y-1 rounded-xl bg-accent-soft px-4 py-3 text-sm text-danger">
            @foreach (var errorMessage in _actionErrors)
            {
                <p>@Text(errorMessage)</p>
            }
        </div>
    }

    @if (_rows.Count == 0)
    {
        <div class="mx-auto max-w-md rounded-3xl border border-border bg-surface-alt px-8 py-14 text-center">
            <p class="font-script text-3xl text-accent">@Text(Texts.EmptyTitle)</p>
            <p class="mt-3 text-muted">@Text(Texts.EmptyMessage)</p>
        </div>
    }

    @if (_rows.Count > 0)
    {
        <section class="overflow-hidden rounded-2xl border border-border bg-surface shadow-sm">
            <div class="hidden grid-cols-12 gap-4 bg-surface-alt px-4 py-3 text-xs uppercase tracking-widest text-muted md:grid">
                <span class="col-span-4">@Text(Texts.NameLabel)</span>
                <span class="col-span-3">@Text(Texts.CountsColumn)</span>
                <span class="col-span-1">@Text(Texts.OrderLabel)</span>
                <span class="col-span-1">@Text(Texts.StatusLabel)</span>
                <span class="col-span-3">@Text(Texts.ActionsColumn)</span>
            </div>
            <div class="divide-y divide-border">
                @foreach (var row in _rows)
                {
                    <article class="grid gap-3 p-4 md:grid-cols-12 md:items-center md:gap-4">
                        <div class="md:col-span-4">
                            <p class="font-medium text-accent-strong">@Text(row.Name)</p>
                            <p class="text-xs text-muted">@Text(row.Slug)</p>
                        </div>
                        <p class="text-sm text-muted md:col-span-3">@Text(CountsText(row))</p>
                        <p class="text-sm text-muted md:col-span-1">@Text(FormatNumber(row.SortOrder))</p>
                        <div class="md:col-span-1"><span class="@CatalogBadge(row.Status).CssClass">@Text(CatalogBadge(row.Status).Label)</span></div>
                        <div class="md:col-span-3">
                            <StatusActions Status="@row.Status" CanDelete="@row.CanDelete" OnStatus="StatusHandler(row)" OnDelete="DeleteHandler(row)">
                                <button type="button" class="text-accent hover:text-accent-strong" @onclick="EditHandler(row.Id)">@Text(Texts.Edit)</button>
                            </StatusActions>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    private static class Texts
    {
        public const string PageTitle = "Secções | Unayka";
        public const string Title = "Secções";
        public const string Eyebrow = "Catálogo";
        public const string Subtitle = "O primeiro nível da loja, por exemplo chás, cosméticos ou livros.";
        public const string NewLabel = "Nova secção";
        public const string NewTitle = "Nova secção";
        public const string EditTitle = "Editar secção";
        public const string NameLabel = "Nome";
        public const string SlugLabel = "Endereço (slug)";
        public const string StatusLabel = "Estado";
        public const string OrderLabel = "Ordem";
        public const string ImageLabel = "Endereço da imagem";
        public const string DescriptionLabel = "Descrição";
        public const string CountsColumn = "Conteúdo";
        public const string ActionsColumn = "Ações";
        public const string Save = "Guardar";
        public const string Cancel = "Cancelar";
        public const string Edit = "Editar";
        public const string Saved = "Secção guardada.";
        public const string EmptyTitle = "Sem secções";
        public const string EmptyMessage = "Crie a primeira secção para organizar a loja.";
        public const string Categories = "categorias";
        public const string Products = "produtos";
        public const string CountSeparator = " | ";
    }

    private IReadOnlyList<SectionRow> _rows = [];
    private SectionForm? _form;
    private IReadOnlyList<string> _errors = [];
    private IReadOnlyList<string> _actionErrors = [];
    private string _formTitle = Texts.NewTitle;
    private string? _notice;
    private bool _slugEdited;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ReloadAsync();
    }

    private static string CountsText(SectionRow section) =>
        $"{FormatNumber(section.CategoryCount)} {Texts.Categories}{Texts.CountSeparator}{FormatNumber(section.ProductCount)} {Texts.Products}";

    private Func<Task> EditHandler(int id) => () => EditAsync(id);

    private EventCallback<CatalogStatus> StatusHandler(SectionRow section) =>
        EventCallback.Factory.Create<CatalogStatus>(this, status => ChangeStatusAsync(section, status));

    private EventCallback DeleteHandler(SectionRow section) =>
        EventCallback.Factory.Create(this, () => DeleteAsync(section));

    private async Task ReloadAsync()
    {
        _rows = await Taxonomy.ListSectionsAsync();
    }

    private void StartNew()
    {
        _form = new SectionForm { SortOrder = _rows.Count + 1 };
        _formTitle = Texts.NewTitle;
        _slugEdited = false;
        _errors = [];
        _notice = null;
    }

    private async Task EditAsync(int id)
    {
        _form = await Taxonomy.GetSectionAsync(id);
        _formTitle = Texts.EditTitle;
        _slugEdited = true;
        _errors = [];
        _notice = null;
    }

    private void CancelEdit()
    {
        _form = null;
        _errors = [];
    }

    private void OnNameChanged()
    {
        if (_form is not null && !_slugEdited)
        {
            _form.Slug = Slugs.FromName(_form.Name);
        }
    }

    private void OnSlugEdited()
    {
        _slugEdited = true;
    }

    private async Task ChangeStatusAsync(SectionRow section, CatalogStatus status)
    {
        var result = await Taxonomy.SetSectionStatusAsync(ActorUserId, section.Id, status);
        _actionErrors = result.Errors;
        await ReloadAsync();
    }

    private async Task DeleteAsync(SectionRow section)
    {
        var result = await Taxonomy.DeleteSectionAsync(ActorUserId, section.Id);
        _actionErrors = result.Errors;
        await ReloadAsync();
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        var result = await Taxonomy.SaveSectionAsync(ActorUserId, _form);
        _errors = result.Errors;
        if (!result.Succeeded)
        {
            return;
        }

        _form = null;
        _notice = Texts.Saved;
        await ReloadAsync();
    }
}
