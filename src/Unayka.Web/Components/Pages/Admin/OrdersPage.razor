@page "/admin/pedidos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = UnaykaPolicies.Staff)]
@inject IAdminOrders OrderService

<PageTitle>@Texts.PageTitle</PageTitle>

<div class="mx-auto max-w-6xl space-y-8">
    <AdminPageHeader Title="@Texts.Title" Eyebrow="@Texts.Eyebrow" Subtitle="@Texts.Subtitle"/>

    <section class="grid gap-4 rounded-2xl border border-sand bg-white p-5 shadow-sm sm:grid-cols-2 lg:grid-cols-6">
        <div class="lg:col-span-2">
            <label for="order-search" class="field-label">@Text(Texts.SearchLabel)</label>
            <input id="order-search" type="search" class="field" placeholder="@Texts.SearchPlaceholder" @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey"/>
        </div>
        <div>
            <label for="order-status" class="field-label">@Text(Texts.StatusLabel)</label>
            <select id="order-status" class="field" @bind="_status">
                @foreach (var option in AdminOptions.OrderStatuses)
                {
                    <option value="@option.Value">@Text(option.Label)</option>
                }
            </select>
        </div>
        <div>
            <label for="order-channel" class="field-label">@Text(Texts.ChannelLabel)</label>
            <select id="order-channel" class="field" @bind="_channel">
                @foreach (var option in AdminOptions.Channels)
                {
                    <option value="@option.Value">@Text(option.Label)</option>
                }
            </select>
        </div>
        <div>
            <label for="order-from" class="field-label">@Text(Texts.FromLabel)</label>
            <input id="order-from" type="date" class="field" @bind="_from"/>
        </div>
        <div>
            <label for="order-to" class="field-label">@Text(Texts.ToLabel)</label>
            <input id="order-to" type="date" class="field" @bind="_to"/>
        </div>
        <div class="flex gap-3 sm:col-span-2 lg:col-span-6">
            <button type="button" class="btn-primary px-6 py-2" @onclick="ApplyAsync">@Text(Texts.Apply)</button>
            <button type="button" class="btn-outline px-6 py-2" @onclick="ClearAsync">@Text(Texts.Clear)</button>
        </div>
    </section>

    @if (_result is not null && _result.Items.Count == 0)
    {
        <EmptyState Title="@Texts.EmptyTitle" Message="@Texts.EmptyMessage"/>
    }

    @if (_result is not null && _result.Items.Count > 0)
    {
        <section class="overflow-hidden rounded-2xl border border-sand bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-cream text-xs uppercase tracking-widest text-stone">
                        <tr>
                            <th class="px-5 py-3 font-medium">@Text(Texts.NumberColumn)</th>
                            <th class="px-5 py-3 font-medium">@Text(Texts.CustomerColumn)</th>
                            <th class="px-5 py-3 font-medium">@Text(Texts.ChannelColumn)</th>
                            <th class="px-5 py-3 font-medium">@Text(Texts.StatusColumn)</th>
                            <th class="px-5 py-3 text-right font-medium">@Text(Texts.TotalColumn)</th>
                            <th class="px-5 py-3 font-medium">@Text(Texts.DateColumn)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-sand">
                        @foreach (var order in _result.Items)
                        {
                            <tr class="hover:bg-cream/60">
                                <td class="px-5 py-3"><a href="@ToUrl(OrderUrl(order.Number))" class="font-medium text-espresso hover:text-clay">@Text(order.Number)</a></td>
                                <td class="px-5 py-3">@Text(order.CustomerName)</td>
                                <td class="px-5 py-3 text-stone">@Text(ChannelLabel(order.Channel))</td>
                                <td class="px-5 py-3"><StatusBadge Order="@order.Status"/></td>
                                <td class="whitespace-nowrap px-5 py-3 text-right">@Text(FormatMoney(order.TotalMinor))</td>
                                <td class="whitespace-nowrap px-5 py-3 text-stone">@Text(FormatDateTime(order.CreatedAt))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        <AdminPager Page="@_result.Page" PageCount="@_result.PageCount" OnPage="LoadPageAsync"/>
    }
</div>

@code {
    private static class Texts
    {
        public const string PageTitle = "Pedidos | Unayka";
        public const string Title = "Pedidos";
        public const string Eyebrow = "Vendas";
        public const string Subtitle = "Online e balcão, do pagamento à entrega.";
        public const string SearchLabel = "Pesquisar";
        public const string SearchPlaceholder = "Número, nome ou telefone";
        public const string StatusLabel = "Estado";
        public const string ChannelLabel = "Canal";
        public const string FromLabel = "De";
        public const string ToLabel = "Até";
        public const string Apply = "Filtrar";
        public const string Clear = "Limpar";
        public const string EmptyTitle = "Sem pedidos";
        public const string EmptyMessage = "Nenhum pedido corresponde aos filtros escolhidos.";
        public const string NumberColumn = "Pedido";
        public const string CustomerColumn = "Cliente";
        public const string ChannelColumn = "Canal";
        public const string StatusColumn = "Estado";
        public const string TotalColumn = "Total";
        public const string DateColumn = "Data";
        public const string EnterKey = "Enter";
    }

    private string _search = string.Empty;
    private string _status = string.Empty;
    private string _channel = string.Empty;
    private DateOnly? _from;
    private DateOnly? _to;
    private PagedResult<OrderSummary>? _result;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadPageAsync(1);
    }

    private static string OrderUrl(string number) => $"/admin/pedidos/{number}";

    private Task ApplyAsync() => LoadPageAsync(1);

    private async Task ClearAsync()
    {
        _search = string.Empty;
        _status = string.Empty;
        _channel = string.Empty;
        _from = null;
        _to = null;
        await LoadPageAsync(1);
    }

    private async Task OnSearchKey(KeyboardEventArgs args)
    {
        if (args.Key == Texts.EnterKey)
        {
            await LoadPageAsync(1);
        }
    }

    private async Task LoadPageAsync(int page)
    {
        var filter = new OrderFilter(
            AdminOptions.ParseOrNull<OrderStatus>(_status),
            AdminOptions.ParseOrNull<OrderChannel>(_channel),
            _search,
            _from,
            _to);
        _result = await OrderService.ListAsync(filter, page);
    }
}
