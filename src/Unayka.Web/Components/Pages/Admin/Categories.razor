@page "/admin/categorias"
@rendermode InteractiveServer
@attribute [Authorize(Policy = UnaykaPolicies.Management)]
@inject IAdminCatalog Catalog

<PageTitle>@Texts.PageTitle</PageTitle>

<div class="mx-auto max-w-6xl space-y-8">
    <AdminPageHeader Title="@Texts.Title" Eyebrow="@Texts.Eyebrow" Subtitle="@Texts.Subtitle">
        <button type="button" class="btn-primary px-6 py-2" @onclick="StartNew">@Text(Texts.NewLabel)</button>
    </AdminPageHeader>

    @if (_form is not null)
    {
        <form class="space-y-5 rounded-2xl border border-sand bg-white p-5 shadow-sm sm:p-8" @onsubmit="SaveAsync">
            <h2 class="font-serif text-2xl">@Text(_formTitle)</h2>
            <ErrorList Messages="@_errors"/>
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label for="category-name" class="field-label">@Text(Texts.NameLabel)</label>
                    <input id="category-name" type="text" maxlength="80" class="field" @bind="_form.Name" @bind:event="oninput" @bind:after="OnNameChanged"/>
                </div>
                <div>
                    <label for="category-slug" class="field-label">@Text(Texts.SlugLabel)</label>
                    <input id="category-slug" type="text" maxlength="80" class="field" @bind="_form.Slug" @bind:after="OnSlugEdited"/>
                </div>
                <div>
                    <label for="category-kind" class="field-label">@Text(Texts.KindLabel)</label>
                    <select id="category-kind" class="field" @bind="_form.Kind">
                        @foreach (var option in AdminOptions.CategoryKinds)
                        {
                            <option value="@option.Value">@Text(option.Label)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="category-order" class="field-label">@Text(Texts.OrderLabel)</label>
                    <input id="category-order" type="number" step="1" class="field" @bind="_form.SortOrder"/>
                </div>
                <div class="sm:col-span-2">
                    <label for="category-image" class="field-label">@Text(Texts.ImageLabel)</label>
                    <input id="category-image" type="url" class="field" @bind="_form.ImageUrl"/>
                </div>
                <div class="sm:col-span-2">
                    <label for="category-description" class="field-label">@Text(Texts.DescriptionLabel)</label>
                    <textarea id="category-description" rows="3" class="field" @bind="_form.Description"></textarea>
                </div>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="btn-primary px-8">@Text(Texts.Save)</button>
                <button type="button" class="btn-outline px-8" @onclick="CancelEdit">@Text(Texts.Cancel)</button>
            </div>
        </form>
    }

    @if (_notice is not null)
    {
        <p class="rounded-xl bg-sage-soft px-4 py-3 text-sm text-espresso">@Text(_notice)</p>
    }

    @if (_rows.Count == 0)
    {
        <EmptyState Title="@Texts.EmptyTitle" Message="@Texts.EmptyMessage"/>
    }

    @if (_rows.Count > 0)
    {
        <section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var category in _rows)
            {
                <article class="overflow-hidden rounded-2xl border border-sand bg-white shadow-sm transition hover:shadow-md">
                    <div class="h-36 bg-cream">
                        <img src="@ToUrl(category.ImageUrl)" alt="" loading="lazy" class="h-full w-full object-cover"/>
                    </div>
                    <div class="space-y-3 p-5">
                        <div class="flex items-start justify-between gap-3">
                            <h2 class="font-serif text-2xl">@Text(category.Name)</h2>
                            <span class="rounded-full bg-cream px-3 py-1 text-xs text-stone">@Text(KindLabel(category.Kind))</span>
                        </div>
                        <p class="text-xs text-stone">@Text(CategoryDetail(category))</p>
                        <button type="button" class="text-sm text-clay hover:text-espresso" @onclick="EditHandler(category.Id)">@Text(Texts.Edit)</button>
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    private static class Texts
    {
        public const string PageTitle = "Categorias | Unayka";
        public const string Title = "Categorias";
        public const string Eyebrow = "Catálogo";
        public const string Subtitle = "Como os produtos se organizam na loja.";
        public const string NewLabel = "Nova categoria";
        public const string NewTitle = "Nova categoria";
        public const string EditTitle = "Editar categoria";
        public const string NameLabel = "Nome";
        public const string SlugLabel = "Endereço (slug)";
        public const string KindLabel = "Tipo";
        public const string OrderLabel = "Ordem";
        public const string ImageLabel = "Endereço da imagem";
        public const string DescriptionLabel = "Descrição";
        public const string Save = "Guardar";
        public const string Cancel = "Cancelar";
        public const string Edit = "Editar";
        public const string Saved = "Categoria guardada.";
        public const string EmptyTitle = "Sem categorias";
        public const string EmptyMessage = "Crie a primeira categoria para organizar os produtos.";
        public const string Products = "produtos";
        public const string Order = "ordem";
    }

    private IReadOnlyList<CategoryRow> _rows = [];
    private CategoryForm? _form;
    private IReadOnlyList<string> _errors = [];
    private string _formTitle = Texts.NewTitle;
    private string? _notice;
    private bool _slugEdited;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ReloadAsync();
    }

    private static string KindLabel(Core.Catalog.CategoryKind kind) =>
        AdminOptions.CategoryKinds.First(option => option.Value == kind.ToString()).Label;

    private static string CategoryDetail(CategoryRow category) =>
        $"{FormatNumber(category.ProductCount)} {Texts.Products} | {Texts.Order} {FormatNumber(category.SortOrder)} | {category.Slug}";

    private Func<Task> EditHandler(int id) => () => EditAsync(id);

    private async Task ReloadAsync()
    {
        _rows = await Catalog.ListCategoriesAsync();
    }

    private void StartNew()
    {
        _form = new CategoryForm { SortOrder = _rows.Count + 1 };
        _formTitle = Texts.NewTitle;
        _slugEdited = false;
        _errors = [];
        _notice = null;
    }

    private async Task EditAsync(int id)
    {
        _form = await Catalog.GetCategoryAsync(id);
        _formTitle = Texts.EditTitle;
        _slugEdited = true;
        _errors = [];
        _notice = null;
    }

    private void CancelEdit()
    {
        _form = null;
        _errors = [];
    }

    private void OnNameChanged()
    {
        if (_form is not null && !_slugEdited)
        {
            _form.Slug = Slugs.FromName(_form.Name);
        }
    }

    private void OnSlugEdited()
    {
        _slugEdited = true;
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        var result = await Catalog.SaveCategoryAsync(ActorUserId, _form);
        _errors = result.Errors;
        if (!result.Succeeded)
        {
            return;
        }

        _form = null;
        _notice = Texts.Saved;
        await ReloadAsync();
    }
}
