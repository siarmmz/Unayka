@page "/admin/etiquetas"
@rendermode InteractiveServer
@attribute [Authorize(Policy = UnaykaPolicies.Management)]
@inject IAdminTaxonomy Taxonomy

<PageTitle>@Texts.PageTitle</PageTitle>

<div class="mx-auto max-w-6xl space-y-6">
    <AdminPageHeader Title="@Texts.Title" Eyebrow="@Texts.Eyebrow" Subtitle="@Texts.Subtitle">
        <button type="button" class="btn-primary px-6 py-2" @onclick="StartNew">@Text(Texts.NewLabel)</button>
    </AdminPageHeader>

    @if (_form is not null)
    {
        <form class="space-y-5 rounded-2xl border border-border bg-surface p-5 shadow-sm sm:p-8" @onsubmit="SaveAsync">
            <h2 class="font-serif text-2xl">@Text(_formTitle)</h2>
            <ErrorList Messages="@_errors"/>
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label for="tag-name" class="field-label">@Text(Texts.NameLabel)</label>
                    <input id="tag-name" type="text" maxlength="60" class="field" @bind="_form.Name" @bind:event="oninput" @bind:after="OnNameChanged"/>
                </div>
                <div>
                    <label for="tag-slug" class="field-label">@Text(Texts.SlugLabel)</label>
                    <input id="tag-slug" type="text" maxlength="80" class="field" @bind="_form.Slug" @bind:after="OnSlugEdited"/>
                </div>
                <div>
                    <label for="tag-section" class="field-label">@Text(Texts.SectionLabel)</label>
                    <select id="tag-section" class="field" @bind="_form.SectionId">
                        @foreach (var option in _sections)
                        {
                            <option value="@option.Id">@Text(option.Name)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="tag-order" class="field-label">@Text(Texts.OrderLabel)</label>
                    <input id="tag-order" type="number" step="1" class="field" @bind="_form.SortOrder"/>
                </div>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="btn-primary px-8">@Text(Texts.Save)</button>
                <button type="button" class="btn-outline px-8" @onclick="CancelEdit">@Text(Texts.Cancel)</button>
            </div>
        </form>
    }

    @if (_notice is not null)
    {
        <p class="rounded-xl bg-success-soft px-4 py-3 text-sm text-accent-strong">@Text(_notice)</p>
    }

    <ErrorList Messages="@_actionErrors"/>

    @if (_rows.Count == 0)
    {
        <EmptyState Title="@Texts.EmptyTitle" Message="@Texts.EmptyMessage"/>
    }

    @if (_rows.Count > 0)
    {
        <section class="overflow-hidden rounded-2xl border border-border bg-surface shadow-sm">
            <div class="hidden grid-cols-12 gap-4 bg-surface-alt px-4 py-3 text-xs uppercase tracking-widest text-muted md:grid">
                <span class="col-span-4">@Text(Texts.NameLabel)</span>
                <span class="col-span-3">@Text(Texts.SectionLabel)</span>
                <span class="col-span-1">@Text(Texts.ProductsColumn)</span>
                <span class="col-span-1">@Text(Texts.OrderLabel)</span>
                <span class="col-span-3">@Text(Texts.ActionsColumn)</span>
            </div>
            <div class="divide-y divide-border">
                @foreach (var tag in _rows)
                {
                    <article class="grid gap-3 p-4 md:grid-cols-12 md:items-center md:gap-4">
                        <div class="md:col-span-4">
                            <p class="font-medium text-accent-strong">@Text(tag.Name)</p>
                            <p class="text-xs text-muted">@Text(tag.Slug)</p>
                        </div>
                        <p class="text-sm text-muted md:col-span-3">@Text(tag.SectionName)</p>
                        <p class="text-sm text-muted md:col-span-1">@Text(FormatNumber(tag.ProductCount))</p>
                        <p class="text-sm text-muted md:col-span-1">@Text(FormatNumber(tag.SortOrder))</p>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm md:col-span-3">
                            <button type="button" class="text-accent hover:text-accent-strong" @onclick="EditHandler(tag.Id)">@Text(Texts.Edit)</button>
                            @if (_confirmingId == tag.Id)
                            {
                                <span class="text-muted">@Text(Texts.ConfirmQuestion)</span>
                                <button type="button" class="text-accent hover:text-accent-strong" @onclick="DeleteHandler(tag)">@Text(Texts.Confirm)</button>
                                <button type="button" class="text-muted hover:text-accent-strong" @onclick="CancelDelete">@Text(Texts.Cancel)</button>
                            }
                            @if (_confirmingId != tag.Id)
                            {
                                <button type="button" class="text-accent hover:text-accent-strong" @onclick="ConfirmHandler(tag.Id)">@Text(Texts.Delete)</button>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    private static class Texts
    {
        public const string PageTitle = "Etiquetas | Unayka";
        public const string Title = "Etiquetas";
        public const string Eyebrow = "Catálogo";
        public const string Subtitle = "Palavras que ajudam a filtrar os produtos de cada secção.";
        public const string NewLabel = "Nova etiqueta";
        public const string NewTitle = "Nova etiqueta";
        public const string EditTitle = "Editar etiqueta";
        public const string NameLabel = "Nome";
        public const string SlugLabel = "Endereço (slug)";
        public const string SectionLabel = "Secção";
        public const string OrderLabel = "Ordem";
        public const string ProductsColumn = "Produtos";
        public const string ActionsColumn = "Ações";
        public const string Save = "Guardar";
        public const string Cancel = "Cancelar";
        public const string Edit = "Editar";
        public const string Delete = "Eliminar";
        public const string Confirm = "Confirmar";
        public const string ConfirmQuestion = "Eliminar de vez?";
        public const string Saved = "Etiqueta guardada.";
        public const string EmptyTitle = "Sem etiquetas";
        public const string EmptyMessage = "Crie a primeira etiqueta para filtrar os produtos.";
    }

    private IReadOnlyList<TagRow> _rows = [];
    private IReadOnlyList<SectionOption> _sections = [];
    private TagForm? _form;
    private IReadOnlyList<string> _errors = [];
    private IReadOnlyList<string> _actionErrors = [];
    private string _formTitle = Texts.NewTitle;
    private string? _notice;
    private bool _slugEdited;
    private int? _confirmingId;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ReloadAsync();
    }

    private Func<Task> EditHandler(int id) => () => EditAsync(id);

    private Action ConfirmHandler(int id) => () => _confirmingId = id;

    private Func<Task> DeleteHandler(TagRow tag) => () => DeleteAsync(tag);

    private async Task ReloadAsync()
    {
        _rows = await Taxonomy.ListTagsAsync();
        _sections = await Taxonomy.ListSectionOptionsAsync();
    }

    private void StartNew()
    {
        _form = new TagForm { SortOrder = _rows.Count + 1, SectionId = _sections.FirstOrDefault()?.Id ?? 0 };
        _formTitle = Texts.NewTitle;
        _slugEdited = false;
        _errors = [];
        _notice = null;
    }

    private async Task EditAsync(int id)
    {
        _form = await Taxonomy.GetTagAsync(id);
        _formTitle = Texts.EditTitle;
        _slugEdited = true;
        _errors = [];
        _notice = null;
    }

    private void CancelEdit()
    {
        _form = null;
        _errors = [];
    }

    private void CancelDelete()
    {
        _confirmingId = null;
    }

    private void OnNameChanged()
    {
        if (_form is not null && !_slugEdited)
        {
            _form.Slug = Slugs.FromName(_form.Name);
        }
    }

    private void OnSlugEdited()
    {
        _slugEdited = true;
    }

    private async Task DeleteAsync(TagRow tag)
    {
        _confirmingId = null;
        var result = await Taxonomy.DeleteTagAsync(ActorUserId, tag.Id);
        _actionErrors = result.Errors;
        await ReloadAsync();
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        var result = await Taxonomy.SaveTagAsync(ActorUserId, _form);
        _errors = result.Errors;
        if (!result.Succeeded)
        {
            return;
        }

        _form = null;
        _notice = Texts.Saved;
        await ReloadAsync();
    }
}
