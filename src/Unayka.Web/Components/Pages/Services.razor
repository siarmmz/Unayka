@page "/services"

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<h1 class="font-script text-5xl leading-tight">@Text(Data.Title)</h1>

<div class="mt-10 grid gap-8">
    @foreach (var service in Data.Services)
    {
        <section class="border-t border-sand pt-6">
            <h2 class="text-2xl">@Text(service.Title)</h2>
            <p class="mt-3">@Text(service.Description)</p>
        </section>
    }
</div>

@code {
    private static readonly (string Title, (string Title, string Description)[] Services, (string Title, string Description) Seo) Data = (
        "Serviços",
        [
            ("Cafés", "Preparamos cafés na hora, para tomar no salão ou levar consigo."),
            ("Cosméticos", "Produtos selecionados para a pele e o cabelo, com informação clara de composição."),
            ("Pedidos online", "Faça o pedido no telemóvel e levante na loja quando estiver pronto."),
            ("Pagamento por carteira móvel", "Receba o pedido de pagamento no telemóvel e confirme em segundos."),
        ],
        ("Serviços | Unayka", "Cafés, cosméticos, pedidos online e pagamento por carteira móvel.")
    );
}
