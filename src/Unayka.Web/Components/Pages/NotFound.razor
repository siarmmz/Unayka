@page "/not-found"
@layout MainLayout

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<h1 class="font-script text-5xl leading-tight">@Text(Data.Title)</h1>
<p class="mt-6 text-lg">@Text(Data.Message)</p>
<a href="@ToUrl(Data.HomeUrl)" class="inline-block mt-8 border-b border-ink pb-1">@Text(Data.HomeLabel)</a>

@code {
    private static readonly (string Title, string Message, string HomeLabel, string HomeUrl, (string Title, string Description) Seo) Data = (
        "Página não encontrada",
        "A página que procura não existe ou foi movida.",
        "Voltar ao início",
        "/",
        ("Página não encontrada | Unayka", "A página que procura não existe.")
    );
}
