@page "/checkout"
@using System.Globalization
@using System.Security.Claims
@using Unayka.Core.Locations
@using Unayka.Web.Components.Checkout
@using Unayka.Web.Endpoints.Account
@using Unayka.Web.Endpoints.Cart
@using Unayka.Web.Endpoints.Checkout
@inject ICartService Carts
@inject ILocationDirectory Locations

<SeoComponent Title="@Texts.SeoTitle" Description="@Texts.SeoDescription"/>

<section class="container-page py-12 lg:py-20">
    <SectionHeading Title="@Texts.Title" Eyebrow="@Texts.Eyebrow" Subtitle="@Texts.Subtitle"/>

    @if (_isEmpty)
    {
        <div class="mt-12">
            <EmptyState Title="@Texts.EmptyTitle" Message="@Texts.EmptyMessage" ActionLabel="@Texts.EmptyAction" ActionUrl="@Texts.ShopUrl"/>
        </div>
    }

    @if (!_isEmpty)
    {
        <form method="post" action="@Texts.ConfirmAction" class="group mt-12 grid gap-12 lg:grid-cols-5">
            <AntiforgeryToken/>
            <div class="space-y-10 lg:col-span-3">
                @if (_error is not null)
                {
                    <p role="alert" class="rounded-xl bg-rose-soft px-4 py-3 text-sm text-red-700">@Text(_error)</p>
                }

                <fieldset class="space-y-5 rounded-3xl border border-sand p-6 sm:p-8">
                    <legend class="px-2 font-serif text-2xl text-espresso">@Text(Texts.ContactTitle)</legend>
                    <div>
                        <label for="name" class="field-label">@Text(Texts.NameLabel)</label>
                        <input id="name" name="name" type="text" maxlength="80" autocomplete="name" required value="@_name" class="field"/>
                    </div>
                    <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                            <label for="phone" class="field-label">@Text(Texts.PhoneLabel)</label>
                            <div class="flex items-stretch gap-2">
                                <span class="flex items-center rounded-xl border border-sand bg-cream px-4 text-sm text-stone">@Text(Texts.CountryCode)</span>
                                <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required pattern="@Texts.PhonePattern" placeholder="@Texts.PhonePlaceholder" value="@_phone" class="field"/>
                            </div>
                        </div>
                        <div>
                            <label for="email" class="field-label">@Text(Texts.EmailLabel)</label>
                            <input id="email" name="email" type="email" maxlength="120" autocomplete="email" value="@_email" class="field"/>
                        </div>
                    </div>
                    <div>
                        <label for="notes" class="field-label">@Text(Texts.NotesLabel)</label>
                        <textarea id="notes" name="notes" rows="2" maxlength="500" placeholder="@Texts.NotesPlaceholder" class="field">@_notes</textarea>
                    </div>
                </fieldset>

                @if (_pickups.Count > 0)
                {
                    <fieldset class="space-y-5 rounded-3xl border border-sand p-6 sm:p-8">
                        <legend class="px-2 font-serif text-2xl text-espresso">@Text(Texts.PickupTitle)</legend>
                        <p class="text-sm text-stone">@Text(Texts.PickupIntro)</p>
                        <div class="grid gap-4 md:grid-cols-2">
                            @foreach (var pickup in _pickups)
                            {
                                <div class="space-y-2 rounded-2xl border border-sand bg-paper p-5">
                                    <p class="font-serif text-xl text-espresso">@Text(pickup.Name)</p>
                                    <p class="text-sm text-ink">@Text(pickup.Address)</p>
                                    <p class="text-sm text-stone">@Text(pickup.Hours)</p>
                                    <ul class="space-y-1 border-t border-sand pt-3 text-sm text-espresso">
                                        @foreach (var item in pickup.Items)
                                        {
                                            <li>@Text(item)</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </fieldset>
                }

                @if (_digitalItems.Count > 0)
                {
                    <fieldset class="space-y-3 rounded-3xl border border-sand p-6 sm:p-8">
                        <legend class="px-2 font-serif text-2xl text-espresso">@Text(Texts.DigitalTitle)</legend>
                        <p class="text-sm text-stone">@Text(Texts.DigitalIntro)</p>
                        <ul class="space-y-1 text-sm text-espresso">
                            @foreach (var item in _digitalItems)
                            {
                                <li>@Text(item)</li>
                            }
                        </ul>
                    </fieldset>
                }

                <fieldset class="space-y-5 rounded-3xl border border-sand p-6 sm:p-8">
                    <legend class="px-2 font-serif text-2xl text-espresso">@Text(Texts.PaymentTitle)</legend>
                    <div class="grid gap-4 sm:grid-cols-2">
                        @foreach (var option in _methodOptions)
                        {
                            <label class="flex min-h-16 cursor-pointer items-center gap-4 rounded-2xl border border-sand bg-white p-4 transition hover:border-clay has-[:checked]:border-espresso has-[:checked]:bg-cream">
                                <input type="radio" name="method" id="@option.Id" value="@option.Value" checked="@option.IsSelected" class="h-5 w-5 accent-espresso"/>
                                <span class="flex shrink-0 gap-1.5">
                                    @foreach (var icon in option.Icons)
                                    {
                                        <img src="@icon.Url" alt="@icon.Alt" width="40" height="40" class="h-10 w-10 rounded-lg border border-sand bg-white object-contain p-0.5"/>
                                    }
                                </span>
                                <span class="font-medium text-espresso">@Text(option.Title)</span>
                            </label>
                        }
                    </div>
                    <div class="group-has-[#method-card:checked]:hidden">
                        <label for="walletPhone" class="field-label">@Text(Texts.WalletLabel)</label>
                        <div class="flex items-stretch gap-2">
                            <span class="flex items-center rounded-xl border border-sand bg-cream px-4 text-sm text-stone">@Text(Texts.CountryCode)</span>
                            <input id="walletPhone" name="walletPhone" type="tel" inputmode="numeric" pattern="@Texts.PhonePattern" placeholder="@Texts.PhonePlaceholder" value="@_wallet" class="field"/>
                        </div>
                        <p class="mt-2 text-xs text-stone">@Text(Texts.WalletHint)</p>
                    </div>
                    <p class="hidden rounded-xl bg-sage-soft px-4 py-3 text-sm text-espresso group-has-[#method-card:checked]:block">@Text(Texts.CardHint)</p>
                </fieldset>
            </div>

            <aside class="h-fit space-y-6 rounded-3xl border border-sand bg-cream/60 p-8 lg:col-span-2">
                <h2 class="font-serif text-2xl text-espresso">@Text(Texts.SummaryTitle)</h2>
                <ul class="divide-y divide-sand">
                    @foreach (var line in _lines)
                    {
                        <li class="flex items-center gap-4 py-3">
                            <img src="@line.ImageUrl" alt="@line.Name" class="h-14 w-12 rounded-lg bg-cream object-cover"/>
                            <div class="flex-1 text-sm">
                                <p class="text-espresso">@Text(line.Name)</p>
                                <p class="text-stone">@Text(line.Quantity)</p>
                                <p class="text-stone">@Text(line.Where)</p>
                            </div>
                            <p class="text-sm">@Text(line.Total)</p>
                        </li>
                    }
                </ul>
                <dl class="space-y-3 text-sm">
                    <div class="flex justify-between"><dt class="text-stone">@Text(Texts.SubtotalLabel)</dt><dd>@Text(_subtotal)</dd></div>
                    @if (_discount is not null)
                    {
                        <div class="flex justify-between"><dt class="text-stone">@Text(_discountLabel)</dt><dd class="text-sage">@Text(_discount)</dd></div>
                    }
                    <div class="flex justify-between border-t border-sand pt-4 font-serif text-xl text-espresso">
                        <dt>@Text(Texts.TotalLabel)</dt>
                        <dd>@Text(_total)</dd>
                    </div>
                </dl>
                @if (_needsSignIn)
                {
                    <p role="alert" class="rounded-xl bg-rose-soft px-4 py-3 text-sm text-red-700">@Text(Texts.SignInNeeded)</p>
                    <a href="@_signInUrl" class="btn-primary w-full">@Text(Texts.SignInLabel)</a>
                }
                @if (!_needsSignIn)
                {
                    <button type="submit" class="btn-primary w-full">@Text(Texts.PlaceOrderButton)</button>
                }
                <p class="text-center text-xs text-stone">@Text(Texts.PaymentNote)</p>
                <a href="@Texts.CartUrl" class="block text-center text-sm text-stone underline underline-offset-4 hover:text-clay">@Text(Texts.BackToCart)</a>
            </aside>
        </form>
    }
</section>

@code {
    private sealed record CheckoutTexts(
        string SeoTitle, string SeoDescription, string Eyebrow, string Title, string Subtitle,
        string EmptyTitle, string EmptyMessage, string EmptyAction, string ShopUrl, string CartUrl, string ConfirmAction,
        string ContactTitle, string NameLabel, string PhoneLabel, string CountryCode, string PhonePlaceholder, string PhonePattern, string EmailLabel,
        string PickupTitle, string PickupIntro, string DigitalTitle, string DigitalIntro, string NotesLabel, string NotesPlaceholder,
        string PaymentTitle, string WalletLabel, string WalletHint, string CardHint,
        string SummaryTitle, string SubtotalLabel, string DiscountTemplate, string TotalLabel,
        string PlaceOrderButton, string PaymentNote, string BackToCart, string QuantityTemplate, string StockTemplate,
        string SignInNeeded, string SignInLabel, string DigitalLine, string PickupLineTemplate, string ItemTemplate);

    private sealed record ChoiceOption(string Id, string Value, string Title, bool IsSelected, IReadOnlyList<PaymentIcon> Icons);

    private sealed record SummaryLine(string Name, string Quantity, string Total, string ImageUrl, string Where);

    private sealed record PickupInfo(string Name, string Address, string Hours, IReadOnlyList<string> Items);

    private static readonly CheckoutTexts Texts = new(
        "Finalizar compra | Unayka",
        "Indique os seus dados, confirme a loja de levantamento e pague com M-Pesa, e-Mola, mKesh ou cartão.",
        "Quase lá",
        "Finalizar compra",
        "Uma única página, sem registos obrigatórios.",
        "Não há nada para pagar",
        "O carrinho está vazio. Escolha alguns produtos na loja.",
        "Ver a loja",
        StoreUrls.Shop,
        StoreUrls.Cart,
        "/checkout/confirmar",
        "Os seus dados",
        "Nome",
        "Telemóvel",
        "+258",
        "84 123 4567",
        @"(\+?258)?\s?8\d[\s]?\d{3}[\s]?\d{4}",
        "Email (opcional)",
        "Levantamento na loja",
        "Pode alterar a loja de cada produto no carrinho. Avisamos por mensagem quando estiver pronto.",
        "Produtos digitais",
        "Sem levantamento. A descarga fica disponível na sua conta assim que o pagamento for confirmado.",
        "Notas para o pedido (opcional)",
        "Alguma preferência ou indicação para o levantamento",
        "Pagamento",
        "Número da carteira móvel",
        "Vai receber um pedido de confirmação no telemóvel. Aceite com o seu PIN para concluir.",
        "Depois de confirmar o pedido, introduza os dados do cartão Visa ou Mastercard na página segura de pagamento.",
        "Resumo do pedido",
        "Subtotal",
        "Desconto ({0})",
        "Total",
        "Confirmar e pagar",
        "Pagamento seguro por carteira móvel ou cartão. Só é cobrado depois de confirmar.",
        "Voltar ao carrinho",
        "Quantidade: {0}",
        "Já não temos stock suficiente de {0}. Reveja o carrinho.",
        "Inicie sessão para comprar produtos digitais. Assim pode descarregar sempre que quiser.",
        "Iniciar sessão",
        "Produto digital",
        "Levantar em {0}",
        "{0} x {1}");

    private static readonly Dictionary<string, string> Errors = new()
    {
        [nameof(PlaceOrderOutcome.EmptyCart)] = "O carrinho está vazio.",
        [nameof(PlaceOrderOutcome.InvalidName)] = "Indique o seu nome.",
        [nameof(PlaceOrderOutcome.InvalidPhone)] = "Indique um número de telemóvel válido, com nove dígitos.",
        [nameof(PlaceOrderOutcome.InvalidEmail)] = "O email não parece válido.",
        [nameof(PlaceOrderOutcome.InvalidWalletPhone)] = "Indique o número da carteira móvel, com nove dígitos.",
        [nameof(PlaceOrderOutcome.InvalidPaymentMethod)] = "Escolha M-Pesa, e-Mola, mKesh ou cartão.",
        [nameof(PlaceOrderOutcome.CouponNoLongerValid)] = "O cupão já não é válido. Reveja o carrinho.",
        [nameof(PlaceOrderOutcome.SignInRequired)] = "Inicie sessão para comprar produtos digitais.",
    };

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.ErrorKey)]
    public string? ErrorCode { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.DetailKey)]
    public string? Detail { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.NameKey)]
    public string? NameValue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.PhoneKey)]
    public string? PhoneValue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.EmailKey)]
    public string? EmailValue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.NotesKey)]
    public string? NotesValue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.MethodKey)]
    public string? MethodValue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CheckoutEndpoints.WalletKey)]
    public string? WalletValue { get; set; }

    private bool _isEmpty = true;
    private bool _needsSignIn;
    private string? _error;
    private string _name = string.Empty;
    private string _phone = string.Empty;
    private string _email = string.Empty;
    private string _notes = string.Empty;
    private string _wallet = string.Empty;
    private string _signInUrl = string.Empty;
    private List<ChoiceOption> _methodOptions = [];
    private List<SummaryLine> _lines = [];
    private List<PickupInfo> _pickups = [];
    private List<string> _digitalItems = [];
    private string _subtotal = string.Empty;
    private string? _discount;
    private string _discountLabel = string.Empty;
    private string _total = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var cartId = HttpContext is null ? null : CartCookies.Read(HttpContext.Request);
        var view = await Carts.GetAsync(cartId);
        _isEmpty = view.IsEmpty;
        if (_isEmpty)
        {
            return;
        }

        var locations = await Locations.ActiveAsync();
        PrepareContact(view);
        PrepareOptions();
        PreparePickups(view, locations);
        PrepareSummary(view);
        _error = ResolveError(view);
    }

    private void PrepareContact(CartView view)
    {
        var user = HttpContext?.User;
        _name = NameValue ?? user?.FindFirstValue(ClaimTypes.Name) ?? string.Empty;
        _phone = PhoneValue ?? user?.FindFirstValue(ClaimTypes.MobilePhone) ?? string.Empty;
        _email = EmailValue ?? user?.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
        _notes = NotesValue ?? string.Empty;
        _wallet = WalletValue ?? _phone;
        _needsSignIn = view.HasDigital && CartCookies.ReadUserId(user ?? new ClaimsPrincipal()) is null;
        _signInUrl = ToUrl($"{StoreUrls.SignIn}?{AccountEndpoints.ReturnUrlKey}={Uri.EscapeDataString(StoreUrls.Checkout)}");
    }

    private void PrepareOptions()
    {
        var selected = OnlineMethods.All.FirstOrDefault(method => method.ToString() == MethodValue, OnlineMethods.All[0]);
        _methodOptions = OnlineMethods.All
            .Select(method => new ChoiceOption($"method-{method.ToString().ToLowerInvariant()}", method.ToString(), PaymentChoices.Label(method), method == selected, PaymentChoices.Icons(method)))
            .ToList();
    }

    private void PreparePickups(CartView view, IReadOnlyList<LocationSummary> locations)
    {
        _pickups = view.PickupGroups
            .Select(group =>
            {
                var location = locations.FirstOrDefault(candidate => candidate.Id == group.LocationId);
                return new PickupInfo(group.LocationName, location?.Address ?? string.Empty, location?.OpeningHours ?? string.Empty, group.Lines.Select(ItemLabel).ToList());
            })
            .ToList();
        _digitalItems = view.DigitalLines.Select(ItemLabel).ToList();
    }

    private static string ItemLabel(CartLineView line) =>
        string.Format(CultureInfo.InvariantCulture, Texts.ItemTemplate, line.Quantity, line.Name);

    private void PrepareSummary(CartView view)
    {
        _lines = view.Lines
            .Select(line => new SummaryLine(
                line.Name,
                string.Format(CultureInfo.InvariantCulture, Texts.QuantityTemplate, line.Quantity),
                FormatMoney(line.LineTotalMinor),
                line.ImageUrl,
                line.IsDigital ? Texts.DigitalLine : string.Format(CultureInfo.InvariantCulture, Texts.PickupLineTemplate, line.LocationName)))
            .ToList();
        _subtotal = FormatMoney(view.SubtotalMinor);
        _discount = view.DiscountMinor > 0 ? "-" + FormatMoney(view.DiscountMinor) : null;
        _discountLabel = string.Format(CultureInfo.InvariantCulture, Texts.DiscountTemplate, view.CouponCode);
        _total = FormatMoney(view.TotalMinor);
    }

    private string? ResolveError(CartView view)
    {
        if (ErrorCode == nameof(PlaceOrderOutcome.OutOfStock))
        {
            return string.Format(CultureInfo.InvariantCulture, Texts.StockTemplate, Detail);
        }

        if (ErrorCode is not null && Errors.TryGetValue(ErrorCode, out var message))
        {
            return message;
        }

        return view.HasStockProblem ? string.Format(CultureInfo.InvariantCulture, Texts.StockTemplate, view.Lines.First(line => line.ExceedsStock).Name) : null;
    }
}
