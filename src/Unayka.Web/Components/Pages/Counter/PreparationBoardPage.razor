@page "/balcao/preparacao"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = UnaykaPolicies.Staff)]
@using Unayka.Core.Counter
@inherits StaffPageBase
@implements IDisposable
@inject ICounterPreparation Orders

<PageTitle>@Texts.PageTitle</PageTitle>

<div class="mx-auto max-w-7xl">
    <header class="mb-6">
        <p class="font-script text-3xl text-accent">@Text(Texts.Eyebrow)</p>
        <h1 class="font-serif text-4xl text-accent-strong">@Text(Texts.Title)</h1>
        <p class="mt-1 text-sm text-muted">@Text(Texts.Intro)</p>
    </header>

    <nav class="mb-6 flex flex-wrap items-center gap-2">
        @foreach (var link in CounterLinks)
        {
            <NavLink href="@ToUrl(link.Url)" Match="NavLinkMatch.All" class="rounded-full border border-border bg-surface px-5 py-2 text-sm text-muted transition hover:border-accent hover:text-accent-strong" ActiveClass="border-accent-strong bg-accent-strong text-surface hover:text-surface">@Text(link.Label)</NavLink>
        }
    </nav>

    @if (_board is not null)
    {
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            @foreach (var column in Columns)
            {
                <section class="flex min-h-64 flex-col rounded-3xl bg-surface p-4 shadow-sm">
                    <header class="mb-4 flex items-center justify-between px-1">
                        <h2 class="font-serif text-2xl text-accent-strong">@Text(column.Title)</h2>
                        <span class="rounded-full bg-surface-alt px-3 py-1 text-xs text-muted">@Text(column.Cards.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                    </header>
                    <div class="space-y-3">
                        @foreach (var card in column.Cards)
                        {
                            <article class="rounded-2xl border border-border p-4 transition hover:border-accent">
                                <div class="flex items-start justify-between gap-2">
                                    <p class="font-serif text-xl text-accent-strong">@Text(card.Number)</p>
                                    <span class="@card.ChannelClass">@Text(card.ChannelLabel)</span>
                                </div>
                                <p class="mt-1 text-sm text-muted">@Text(card.Customer)</p>
                                <ul class="mt-3 space-y-1 text-sm text-ink">
                                    @foreach (var item in card.Items)
                                    {
                                        <li>@Text(item)</li>
                                    }
                                </ul>
                                <div class="mt-4 flex items-center justify-between gap-2">
                                    <span class="@card.AgeClass">@Text(card.Age)</span>
                                    @if (card.CanAdvance)
                                    {
                                        <button type="button" @onclick="card.Advance" class="rounded-full bg-accent-strong px-4 py-2 text-xs text-surface transition hover:bg-accent">@Text(AdvanceLabel)</button>
                                    }
                                </div>
                            </article>
                        }
                        @if (column.Cards.Count == 0)
                        {
                            <p class="px-1 py-6 text-center font-script text-2xl text-muted">@Text(EmptyColumn)</p>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    private const int RefreshSeconds = 5;
    private const string EmptyColumn = "Sem pedidos";
    private const string AdvanceLabel = "Avançar";
    private const string CounterLabel = "Balcão";
    private const string OnlineLabel = "Online";
    private const int MinutesPerHour = 60;
    private const int MinutesPerDay = 1440;
    private const int LateAfterMinutes = 10;
    private const string ChannelBase = "rounded-full px-3 py-1 text-xs ";
    private const string CounterClass = ChannelBase + "bg-success-soft text-success";
    private const string OnlineClass = ChannelBase + "bg-accent-soft text-accent";
    private const string AgeNormalClass = "text-xs text-muted";
    private const string AgeLateClass = "text-xs font-medium text-danger";

    private static readonly (string PageTitle, string Eyebrow, string Title, string Intro) Texts = (
        "Preparação | Unayka",
        "Balcão",
        "Preparação",
        "Pedidos online e do balcão. A página atualiza sozinha a cada poucos segundos."
    );

    private static readonly string[] ColumnTitles = ["Novo / Pago", "Em preparação", "Pronto", "Entregue hoje"];

    private PreparationBoard? _board;
    private Timer? _timer;

    private IEnumerable<(string Title, IReadOnlyList<(string Number, string Customer, string ChannelLabel, string ChannelClass, IReadOnlyList<string> Items, string Age, string AgeClass, bool CanAdvance, Func<Task> Advance)> Cards)> Columns =>
        _board is null
            ? []
            : new[] { _board.Incoming, _board.Preparing, _board.Ready, _board.DeliveredToday }
                .Select((cards, index) => (ColumnTitles[index], (IReadOnlyList<(string, string, string, string, IReadOnlyList<string>, string, string, bool, Func<Task>)>)cards.Select(ToCard).ToList()));

    private (string Number, string Customer, string ChannelLabel, string ChannelClass, IReadOnlyList<string> Items, string Age, string AgeClass, bool CanAdvance, Func<Task> Advance) ToCard(PreparationCard card)
    {
        var isCounter = card.Channel == OrderChannel.Counter;
        var canAdvance = PreparationFlow.Next(card.Status) is not null;
        var isLate = card.AgeMinutes >= LateAfterMinutes && canAdvance && card.Status != OrderStatus.Ready;
        return (card.Number, card.CustomerName, isCounter ? CounterLabel : OnlineLabel, isCounter ? CounterClass : OnlineClass, card.Items,
            FormatAge(card.AgeMinutes), isLate ? AgeLateClass : AgeNormalClass, canAdvance, () => Advance(card.OrderId));
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _board = await Orders.LoadBoardAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var period = TimeSpan.FromSeconds(RefreshSeconds);
        _timer = new Timer(_ => _ = InvokeAsync(Refresh), null, period, period);
    }

    private async Task Refresh()
    {
        _board = await Orders.LoadBoardAsync();
        StateHasChanged();
    }

    private async Task Advance(int orderId)
    {
        await Orders.AdvanceAsync(orderId, UserId);
        await Refresh();
    }

    private static string FormatAge(int minutes) => minutes switch
    {
        >= MinutesPerDay => $"há {minutes / MinutesPerDay} dias",
        >= MinutesPerHour => $"há {minutes / MinutesPerHour} h",
        _ => $"há {minutes} min",
    };

    public void Dispose() => _timer?.Dispose();
}
