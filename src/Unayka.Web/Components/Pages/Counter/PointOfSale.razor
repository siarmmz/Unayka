@page "/balcao"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = UnaykaPolicies.Staff)]
@using Unayka.Core.Counter
@inherits StaffPageBase
@inject ICounterShifts Shifts
@inject ICounterSales Sales
@inject IPaymentService Payments

<PageTitle>@Texts.PageTitle</PageTitle>

<div class="mx-auto max-w-7xl">
    <header class="mb-6">
        <p class="font-script text-3xl text-accent">@Text(Texts.Eyebrow)</p>
        <h1 class="font-serif text-4xl text-accent-strong">@Text(Texts.Title)</h1>
    </header>

    <nav class="mb-6 flex flex-wrap items-center gap-2">
        @foreach (var link in CounterLinks)
        {
            <NavLink href="@ToUrl(link.Url)" Match="NavLinkMatch.All" class="rounded-full border border-border bg-surface px-5 py-2 text-sm text-muted transition hover:border-accent hover:text-accent-strong" ActiveClass="border-accent-strong bg-accent-strong text-surface hover:text-surface">@Text(link.Label)</NavLink>
        }
    </nav>

    @if (_loaded)
    {
        @if (!_shiftOpen)
        {
            <section class="mx-auto max-w-lg rounded-3xl bg-surface p-8 shadow-sm">
                <h2 class="font-serif text-2xl text-accent-strong">@Text(Texts.NoShiftTitle)</h2>
                <p class="mt-2 text-sm text-muted">@Text(Texts.NoShiftIntro)</p>
                @if (_error is not null)
                {
                    <p role="alert" class="mt-4 rounded-xl bg-accent-soft px-4 py-3 text-sm text-danger">@Text(_error)</p>
                }
                <div class="mt-6">
                    <label for="opening" class="field-label">@Text(Texts.OpeningLabel)</label>
                    <input id="opening" type="text" inputmode="decimal" @bind="_openingText" @bind:event="oninput" class="field"/>
                </div>
                <button type="button" @onclick="OpenShift" class="btn-primary mt-6 w-full">@Text(Texts.OpenButton)</button>
            </section>
        }

        @if (_shiftOpen && _stage == PosStage.Receipt && _receipt is not null)
        {
            <article class="mx-auto w-full max-w-md rounded-3xl border border-border bg-surface p-8 shadow-sm">
                <header class="text-center">
                    <p class="font-script text-4xl text-accent">@Text(ReceiptHeading)</p>
                    <p class="mt-1 font-serif text-3xl text-accent-strong">@Text(_receipt.Number)</p>
                    <p class="mt-1 text-xs uppercase tracking-widest text-muted">@Text(CounterTimes.FormatDateTime(_receipt.At))</p>
                </header>
                <ul class="mt-6 divide-y divide-border border-y border-border">
                    @foreach (var line in _receipt.Lines)
                    {
                        <li class="flex items-baseline justify-between gap-4 py-2 text-sm">
                            <span class="text-ink">@Text($"{line.Quantity} x {line.Name}")</span>
                            <span class="text-muted">@Text(FormatMoney(line.TotalMinor))</span>
                        </li>
                    }
                </ul>
                <dl class="mt-4 space-y-1 text-sm">
                    @foreach (var row in ReceiptSummary(_receipt))
                    {
                        <div class="flex justify-between">
                            <dt class="text-muted">@Text(row.Label)</dt>
                            <dd class="@row.CssClass">@Text(row.Value)</dd>
                        </div>
                    }
                </dl>
                <div class="mt-6 flex justify-center">
                    <span class="@OrderBadge(_receipt.Status).CssClass">@Text(OrderBadge(_receipt.Status).Label)</span>
                </div>
                <button type="button" @onclick="StartNewSale" class="btn-primary mt-8 w-full">@Text(NewSaleLabel)</button>
            </article>
        }

        @if (_shiftOpen && _stage != PosStage.Receipt)
        {
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_26rem]">
                <section>
                    <div class="mb-4 flex flex-wrap items-center gap-2">
                        @foreach (var tab in Tabs)
                        {
                            <button type="button" @onclick="tab.Select" class="@tab.CssClass">@Text(tab.Label)</button>
                        }
                    </div>
                    <input type="search" @bind="_search" @bind:event="oninput" placeholder="@Texts.SearchPlaceholder" class="field mb-4"/>

                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
                        @foreach (var tile in Tiles)
                        {
                            <button type="button" disabled="@tile.SoldOut" @onclick="tile.Pick" class="@tile.CssClass">
                                <span class="block aspect-[4/3] w-full overflow-hidden bg-surface-alt">
                                    @if (tile.ImageUrl is not null)
                                    {
                                        <img src="@tile.ImageUrl" alt="" loading="lazy" class="h-full w-full object-cover"/>
                                    }
                                </span>
                                <span class="block px-3 py-3">
                                    <span class="block min-h-10 font-serif text-lg leading-tight text-accent-strong">@Text(tile.Name)</span>
                                    <span class="mt-1 flex items-center justify-between text-sm">
                                        <span class="font-medium text-ink">@Text(tile.Price)</span>
                                        <span class="text-xs text-muted">@Text(tile.Stock)</span>
                                    </span>
                                </span>
                            </button>
                        }
                    </div>
                    @if (!VisibleProducts.Any())
                    {
                        <div class="mx-auto max-w-md rounded-3xl border border-border bg-surface-alt px-8 py-14 text-center">
                            <p class="font-script text-3xl text-accent">@Text(Texts.NoProductsTitle)</p>
                            <p class="mt-3 text-muted">@Text(Texts.NoProductsMessage)</p>
                        </div>
                    }
                </section>

                <aside class="h-fit space-y-5 rounded-3xl bg-surface p-6 shadow-sm lg:sticky lg:top-6">
                    <h2 class="font-serif text-2xl text-accent-strong">@Text(Texts.TicketTitle)</h2>

                    @if (_lines.Count == 0)
                    {
                        <p class="py-4 text-center font-script text-2xl text-muted">@Text(Texts.EmptyTicket)</p>
                    }
                    <ul>
                        @foreach (var row in TicketRows)
                        {
                            <li class="flex items-center gap-3 border-b border-border py-3 last:border-b-0">
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium text-ink">@Text(row.Name)</p>
                                    <p class="text-xs text-muted">@Text(row.UnitPrice)</p>
                                </div>
                                <div class="flex items-center gap-1">
                                    <button type="button" @onclick="row.Decrease" class="h-9 w-9 rounded-full border border-border text-accent-strong transition hover:border-accent" aria-label="@DecreaseLabel"><i class="bi bi-dash"></i></button>
                                    <span class="w-8 text-center text-sm">@Text(row.Quantity)</span>
                                    <button type="button" @onclick="row.Increase" class="h-9 w-9 rounded-full border border-border text-accent-strong transition hover:border-accent" aria-label="@IncreaseLabel"><i class="bi bi-plus"></i></button>
                                </div>
                                <p class="w-24 text-right text-sm font-medium">@Text(row.Total)</p>
                                <button type="button" @onclick="row.Remove" class="h-9 w-9 rounded-full text-muted transition hover:bg-accent-soft hover:text-danger" aria-label="@RemoveLabel"><i class="bi bi-x-lg"></i></button>
                            </li>
                        }
                    </ul>

                    <details class="rounded-2xl bg-surface-alt px-4 py-3">
                        <summary class="cursor-pointer text-sm text-accent-strong">@Text(Texts.FreeAmountTitle)</summary>
                        <div class="mt-3 space-y-3">
                            <input type="text" maxlength="80" @bind="_freeDescription" placeholder="@Texts.FreeDescriptionPlaceholder" class="field"/>
                            <input type="text" inputmode="decimal" @bind="_freeAmount" placeholder="@Texts.FreeAmountPlaceholder" class="field"/>
                            <button type="button" @onclick="AddFreeAmount" class="btn-outline w-full">@Text(Texts.FreeAmountButton)</button>
                        </div>
                    </details>

                    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
                        <input type="text" maxlength="80" @bind="_customerName" placeholder="@Texts.CustomerNamePlaceholder" class="field"/>
                        <input type="tel" inputmode="numeric" maxlength="16" @bind="_customerPhone" placeholder="@Texts.CustomerPhonePlaceholder" class="field"/>
                    </div>

                    <div class="flex items-baseline justify-between border-t border-border pt-4">
                        <span class="text-sm uppercase tracking-widest text-muted">@Text(Texts.TotalLabel)</span>
                        <span class="font-serif text-4xl text-accent-strong">@Text(TotalText)</span>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var method in MethodButtons)
                        {
                            <button type="button" @onclick="method.Select" class="@method.CssClass">@Text(method.Label)</button>
                        }
                    </div>

                    @if (_method == PaymentMethod.Cash)
                    {
                        <div class="space-y-2">
                            <label for="received" class="field-label">@Text(Texts.ReceivedLabel)</label>
                            <input id="received" type="text" inputmode="decimal" @bind="_receivedText" @bind:event="oninput" class="field"/>
                            <div class="flex items-center justify-between text-sm">
                                <button type="button" @onclick="FillExact" class="text-accent underline-offset-4 hover:underline">@Text(Texts.ExactLabel)</button>
                                <span class="@ChangeClass">@Text(ChangeText)</span>
                            </div>
                        </div>
                    }

                    @if (IsWallet)
                    {
                        <div class="space-y-2">
                            <label for="wallet" class="field-label">@Text(Texts.WalletPhoneLabel)</label>
                            <input id="wallet" type="tel" inputmode="numeric" maxlength="16" @bind="_walletPhone" @bind:event="oninput" placeholder="@Texts.WalletPhonePlaceholder" class="field"/>
                        </div>
                    }

                    @if (_method == PaymentMethod.Card)
                    {
                        <p class="rounded-xl bg-surface-alt px-4 py-3 text-sm text-muted">@Text(Texts.CardHint)</p>
                    }

                    @if (IsWallet)
                    {
                        <p class="rounded-xl bg-surface-alt px-4 py-3 text-sm text-muted">@Text(Texts.WalletHint)</p>
                    }

                    @if (_methods.Count == 0)
                    {
                        <p role="alert" class="rounded-xl bg-accent-soft px-4 py-3 text-sm text-danger">@Text(Texts.NoMethods)</p>
                    }

                    @if (_error is not null)
                    {
                        <p role="alert" class="rounded-xl bg-accent-soft px-4 py-3 text-sm text-danger">@Text(_error)</p>
                    }

                    <button type="button" @onclick="Pay" disabled="@(_methods.Count == 0)" class="btn-primary w-full disabled:opacity-60">@Text(PayLabel)</button>
                </aside>
            </div>
        }
    }
</div>

@code {
    private const string AllCategoriesLabel = "Todos";
    private const string ReceiptHeading = "Obrigada";
    private const string NewSaleLabel = "Nova venda";
    private const string SoldOutTileLabel = "Esgotado";
    private const string DecreaseLabel = "Diminuir quantidade";
    private const string IncreaseLabel = "Aumentar quantidade";
    private const string RemoveLabel = "Remover linha";
    private const string TileBase = "overflow-hidden rounded-2xl border border-border bg-surface text-left transition ";
    private const string TileClass = TileBase + "hover:border-accent hover:shadow-md active:scale-95";
    private const string TileSoldOutClass = TileBase + "cursor-not-allowed opacity-50";
    private const string ReceiptTextClass = "text-ink";
    private const string ReceiptTotalClass = "font-serif text-xl text-accent-strong";
    private const string TabBase = "rounded-full border px-5 py-2 text-sm transition ";
    private const string TabIdle = TabBase + "border-border bg-surface text-muted hover:border-accent";
    private const string TabActive = TabBase + "border-accent-strong bg-accent-strong text-surface";
    private const string MethodBase = "rounded-2xl border px-3 py-3 text-sm transition ";
    private const string MethodIdle = MethodBase + "border-border bg-surface text-muted hover:border-accent";
    private const string MethodActive = MethodBase + "border-accent-strong bg-accent-strong text-surface";
    private const string ChangeEnoughClass = "font-medium text-accent-strong";
    private const string ChangeMissingClass = "font-medium text-danger";
    private const string ChangeFormat = "Troco {0}";
    private const string MissingFormat = "Falta {0}";
    private const int FirstLineQuantity = 1;
    private const int AllCategoriesId = 0;

    private static readonly (string PageTitle, string Eyebrow, string Title, string NoShiftTitle, string NoShiftIntro, string OpeningLabel, string OpenButton,
        string SearchPlaceholder, string NoProductsTitle, string NoProductsMessage, string TicketTitle, string EmptyTicket, string FreeAmountTitle,
        string FreeDescriptionPlaceholder, string FreeAmountPlaceholder, string FreeAmountButton, string CustomerNamePlaceholder, string CustomerPhonePlaceholder,
        string TotalLabel, string ReceivedLabel, string ExactLabel, string WalletPhoneLabel, string WalletPhonePlaceholder, string CardHint, string CashPay,
        string CardPay, string WalletPay, string WalletHint, string NoMethods, string InvalidAmount, string DefaultFreeDescription) Texts = (
        "Balcão | Unayka",
        "Balcão",
        "Venda ao balcão",
        "Abra o caixa para vender",
        "Indique o valor com que a gaveta começa o turno.",
        "Valor de abertura (MZN)",
        "Abrir caixa",
        "Procurar produto",
        "Nenhum produto encontrado",
        "Experimente outra categoria ou outra pesquisa.",
        "Talão",
        "Toque num produto para o adicionar.",
        "Valor livre",
        "Descrição",
        "Valor (MZN)",
        "Adicionar valor livre",
        "Nome do cliente (opcional)",
        "Telemóvel do cliente (opcional)",
        "Total",
        "Valor recebido (MZN)",
        "Valor exato",
        "Telemóvel da carteira",
        "84 123 4567",
        "Confirme o valor no terminal de cartões e depois registe a venda.",
        "Cobrar em dinheiro",
        "Confirmar pagamento no terminal",
        "Confirmar pagamento recebido na carteira",
        "Confirme na carteira da loja que o pagamento chegou e depois registe a venda.",
        "Os meios de pagamento do balcão não estão configurados.",
        "Indique um valor válido.",
        "Valor livre"
    );

    private static readonly Dictionary<CounterSaleError, string> SaleErrors = new()
    {
        [CounterSaleError.NoOpenShift] = "Abra o caixa antes de vender.",
        [CounterSaleError.EmptyTicket] = "O talão está vazio.",
        [CounterSaleError.InvalidAmount] = "Existe uma linha com valor ou quantidade inválidos.",
        [CounterSaleError.InvalidWalletPhone] = "Indique um número de telemóvel válido para a carteira.",
        [CounterSaleError.InsufficientCash] = "O valor recebido não cobre o total.",
        [CounterSaleError.OutOfStock] = "Um dos produtos já não tem stock suficiente.",
    };

    private IReadOnlyList<PaymentOptionView> _methods = [];

    private sealed record ChoiceView(string Label, string CssClass, Action Select);

    private enum PosStage
    {
        Selling,
        WalletWaiting,
        Receipt,
    }

    private bool _loaded;
    private bool _shiftOpen;
    private CounterCatalog _catalog = new([], []);
    private readonly List<TicketLine> _lines = [];
    private int _categoryId = AllCategoriesId;
    private string _search = string.Empty;
    private string _openingText = "0";
    private string _freeDescription = string.Empty;
    private string _freeAmount = string.Empty;
    private string _customerName = string.Empty;
    private string _customerPhone = string.Empty;
    private string _receivedText = string.Empty;
    private string _walletPhone = string.Empty;
    private PaymentMethod _method = PaymentMethod.Cash;
    private PosStage _stage = PosStage.Selling;
    private string? _error;
    private CounterReceipt? _receipt;

    private long Total => Ticket.Total(_lines);

    private string TotalText => FormatMoney(Total);

    private bool IsWallet => _method.IsWallet();

    private IEnumerable<CounterProduct> VisibleProducts =>
        _catalog.Products
            .Where(product => _categoryId == AllCategoriesId || product.CategoryId == _categoryId)
            .Where(product => string.IsNullOrWhiteSpace(_search) || product.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ChoiceView> Tabs =>
        _catalog.Categories
            .Select(category => (category.Name, category.Id))
            .Prepend((AllCategoriesLabel, AllCategoriesId))
            .Select(tab => new ChoiceView(tab.Item1, _categoryId == tab.Item2 ? TabActive : TabIdle, () => _categoryId = tab.Item2));

    private IEnumerable<ChoiceView> MethodButtons =>
        _methods.Select(option => new ChoiceView(option.Label, _method == option.Method ? MethodActive : MethodIdle, () => SelectMethod(option.Method)));

    private string PayLabel => _method switch
    {
        PaymentMethod.Cash => Texts.CashPay,
        PaymentMethod.Card => Texts.CardPay,
        _ => Texts.WalletPay,
    };

    private long Received => MoneyInput.ParseOrZero(_receivedText);

    private string ChangeText => CashMath.IsSufficient(Received, Total)
        ? string.Format(System.Globalization.CultureInfo.InvariantCulture, ChangeFormat, FormatMoney(CashMath.ChangeDue(Received, Total)))
        : string.Format(System.Globalization.CultureInfo.InvariantCulture, MissingFormat, FormatMoney(Total - Received));

    private string ChangeClass => CashMath.IsSufficient(Received, Total) ? ChangeEnoughClass : ChangeMissingClass;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await Reload();
        _loaded = true;
    }

    private async Task Reload()
    {
        _shiftOpen = await Shifts.GetOpenAsync() is not null;
        _catalog = await Sales.LoadCatalogAsync();
        _methods = await Payments.CounterOptionsAsync();
        if (_methods.Count > 0 && _methods.All(option => option.Method != _method))
        {
            _method = _methods[0].Method;
        }
    }

    private async Task OpenShift()
    {
        @if (!MoneyInput.TryParse(_openingText, out var opening))
        {
            _error = Texts.InvalidAmount;
            return;
        }

        _error = null;
        await Shifts.OpenAsync(UserId, opening);
        await Reload();
    }

    private void SelectMethod(PaymentMethod method)
    {
        _method = method;
        _error = null;
    }

    private void AddProduct(int productId)
    {
        var product = _catalog.Products.FirstOrDefault(candidate => candidate.Id == productId);
        @if (product is null)
        {
            return;
        }

        var index = _lines.FindIndex(line => line.ProductId == productId);
        @if (index < 0)
        {
            _lines.Add(new TicketLine(product.Id, product.Name, product.PriceMinor, FirstLineQuantity));
            return;
        }

        @if (_lines[index].Quantity < product.StockQuantity)
        {
            _lines[index] = _lines[index] with { Quantity = _lines[index].Quantity + 1 };
        }
    }

    private void ChangeQuantity((int Index, int Delta) change)
    {
        var line = _lines[change.Index];
        var quantity = line.Quantity + change.Delta;
        @if (quantity <= 0)
        {
            _lines.RemoveAt(change.Index);
            return;
        }

        var stock = line.IsFreeAmount ? int.MaxValue : _catalog.Products.FirstOrDefault(product => product.Id == line.ProductId)?.StockQuantity ?? 0;
        _lines[change.Index] = line with { Quantity = Math.Min(quantity, stock) };
    }

    private void RemoveLine(int index) => _lines.RemoveAt(index);

    private IEnumerable<(string Name, string? ImageUrl, string Price, string Stock, bool SoldOut, string CssClass, Action Pick)> Tiles =>
        VisibleProducts.Select(product =>
        {
            var soldOut = product.StockQuantity <= 0;
            return (product.Name, product.ImageUrl.Length > 0 ? ToUrl(product.ImageUrl) : null, FormatMoney(product.PriceMinor),
                soldOut ? SoldOutTileLabel : $"{product.StockQuantity} em stock", soldOut, soldOut ? TileSoldOutClass : TileClass, (Action)(() => AddProduct(product.Id)));
        });

    private IEnumerable<(string Name, string UnitPrice, string Quantity, string Total, Action Decrease, Action Increase, Action Remove)> TicketRows =>
        _lines.Select((line, index) => (line.Name, FormatMoney(line.UnitPriceMinor), line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture), FormatMoney(line.TotalMinor),
            (Action)(() => ChangeQuantity((index, -1))), (Action)(() => ChangeQuantity((index, 1))), (Action)(() => RemoveLine(index))));

    private static (string Label, string Value, string CssClass)[] ReceiptSummary(CounterReceipt receipt) =>
    [
        ("Cliente", receipt.CustomerName, ReceiptTextClass),
        ("Pagamento", StatusLabels.For(receipt.Method), ReceiptTextClass),
        ("Recebido", FormatMoney(receipt.ReceivedMinor), ReceiptTextClass),
        ("Troco", FormatMoney(receipt.ChangeMinor), ReceiptTextClass),
        ("Total", FormatMoney(receipt.TotalMinor), ReceiptTotalClass),
    ];

    private void AddFreeAmount()
    {
        @if (!MoneyInput.TryParse(_freeAmount, out var amount) || amount <= 0)
        {
            _error = Texts.InvalidAmount;
            return;
        }

        _error = null;
        var description = string.IsNullOrWhiteSpace(_freeDescription) ? Texts.DefaultFreeDescription : _freeDescription.Trim();
        _lines.Add(new TicketLine(TicketLine.FreeAmountProductId, description, amount, FirstLineQuantity));
        _freeDescription = string.Empty;
        _freeAmount = string.Empty;
    }

    private void FillExact() => _receivedText = (Total / 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private async Task Pay()
    {
        _error = null;
        @if (_lines.Count == 0)
        {
            _error = SaleErrors[CounterSaleError.EmptyTicket];
            return;
        }

        @if (_method == PaymentMethod.Cash && !CashMath.IsSufficient(Received, Total))
        {
            _error = SaleErrors[CounterSaleError.InsufficientCash];
            return;
        }

        @if (IsWallet && !ConfirmWallet())
        {
            return;
        }

        await Register();
    }

    private bool ConfirmWallet()
    {
        if (PhoneNumber.Normalize(_walletPhone) is not null)
        {
            return true;
        }

        _error = SaleErrors[CounterSaleError.InvalidWalletPhone];
        return false;
    }

    private async Task Register()
    {
        var request = new CounterSaleRequest(UserId, _lines.ToList(), _method, _customerName, _customerPhone, _walletPhone, Received);
        var result = await Sales.RegisterAsync(request);
        _stage = PosStage.Selling;
        @if (!result.Succeeded)
        {
            _error = SaleErrors[result.Error];
            await Reload();
            return;
        }

        _receipt = result.Receipt;
        _stage = PosStage.Receipt;
    }

    private async Task StartNewSale()
    {
        _lines.Clear();
        _receipt = null;
        _customerName = string.Empty;
        _customerPhone = string.Empty;
        _receivedText = string.Empty;
        _walletPhone = string.Empty;
        _search = string.Empty;
        _error = null;
        _stage = PosStage.Selling;
        await Reload();
    }
}
