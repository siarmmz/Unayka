@page "/loja/categoria/{Slug}"
@using Unayka.Web.Components.Store
@inject ICatalogQuery Catalog

@if (_category is not null)
{
    <SeoComponent Title="@_seoTitle" Description="@_category.Description"/>

    <PageHero Title="@_category.Name" Eyebrow="@_eyebrow" Subtitle="@_category.Description" ImageUrl="@_category.ImageUrl"/>

    <CatalogView BasePath="@_basePath" Kind="_category.Kind" CategorySlug="@_category.Slug"/>
}

@code {
    private const string TitleSuffix = " | Unayka";
    private const string CoffeeEyebrow = "Cafés";
    private const string CosmeticEyebrow = "Cosméticos";

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private CategorySummary? _category;
    private string _seoTitle = string.Empty;
    private string _eyebrow = string.Empty;
    private string _basePath = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _category = await Catalog.FindCategoryAsync(Slug);
        if (_category is null)
        {
            Navigation.NotFound();
            return;
        }

        _seoTitle = _category.Name + TitleSuffix;
        _eyebrow = _category.Kind == CategoryKind.Coffee ? CoffeeEyebrow : CosmeticEyebrow;
        _basePath = StoreUrls.Category(_category.Slug);
    }
}
