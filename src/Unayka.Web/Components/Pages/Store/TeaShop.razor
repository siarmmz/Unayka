@page "/loja/chas"
@using Unayka.Web.Components.Store

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<PageHero Title="@Data.Title" Eyebrow="@Data.Eyebrow" Subtitle="@Data.Subtitle" ImageUrl="@SiteImages.TeaBannerUrl"/>

<CatalogView BasePath="@StoreUrls.Teas" Kind="CategoryKind.Tea"/>

@code {
    private static readonly (string Title, string Eyebrow, string Subtitle, (string Title, string Description) Seo) Data = (
        "Chás",
        "Da planta à chávena",
        "Chás de plantas, infusões e também os nossos cafés, quentes, gelados ou para preparar em casa.",
        ("Chás | Unayka", "Chás naturais, infusões e cafés selecionados pela Unayka. Encomende online e levante na loja."));
}
