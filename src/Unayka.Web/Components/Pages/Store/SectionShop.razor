@page "/loja/{SectionSlug}"
@using Unayka.Web.Components.Store
@inject ICatalogQuery Catalog

@if (_section is not null)
{
    <SeoComponent Title="@_seoTitle" Description="@_section.Description"/>

    <PageHero Title="@_section.Name" Eyebrow="@Data.Eyebrow" Subtitle="@_section.Description" ImageUrl="@_section.ImageUrl"/>

    <CatalogView BasePath="@_basePath" SectionSlug="@_section.Slug"/>
}

@code {
    private static readonly (string Eyebrow, string TitleSuffix) Data = ("Da nossa loja", " | Unayka");

    [Parameter]
    public string SectionSlug { get; set; } = string.Empty;

    private SectionSummary? _section;
    private string _seoTitle = string.Empty;
    private string _basePath = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _section = await Catalog.FindSectionAsync(SectionSlug);
        if (_section is null)
        {
            Navigation.NotFound();
            return;
        }

        _seoTitle = _section.Name + Data.TitleSuffix;
        _basePath = StoreUrls.Section(_section.Slug);
    }
}
