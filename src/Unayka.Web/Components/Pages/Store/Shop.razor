@page "/loja"
@using Unayka.Web.Components.Store

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<section class="border-b border-sand bg-cream">
    <div class="container-page py-16 md:py-20">
        <SectionHeading Title="@Data.Title" Eyebrow="@Data.Eyebrow" Subtitle="@Data.Subtitle" Centered="true"/>
    </div>
</section>

<CatalogView BasePath="@StoreUrls.Shop"/>

@code {
    private static readonly (string Title, string Eyebrow, string Subtitle, (string Title, string Description) Seo) Data = (
        "Toda a loja",
        "Cafés e cosméticos",
        "Escolha com calma. Levante na loja ou receba em casa, em Maputo.",
        ("Loja | Unayka", "Cafés, grãos e cosméticos selecionados pela Unayka. Pague com M-Pesa ou e-Mola e levante na loja ou receba em Maputo."));
}
