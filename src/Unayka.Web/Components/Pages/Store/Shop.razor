@page "/loja"
@using Unayka.Web.Components.Store
@inject ICatalogQuery Catalog

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<section class="border-b border-border bg-surface-alt">
    <div class="container-page py-10 md:py-14">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="font-script text-3xl text-accent">@Text(Data.Eyebrow)</p>
                <h1 class="mt-1 text-4xl md:text-5xl">@Text(Data.Title)</h1>
            </div>
            <form method="get" action="@_allProductsUrl" class="flex w-full gap-2 md:max-w-md">
                <input type="search" name="@CatalogLinks.QueryKey" placeholder="@Data.SearchPlaceholder" aria-label="@Data.SearchPlaceholder" class="field"/>
                <button type="submit" class="btn-primary shrink-0">@Text(Data.SearchLabel)</button>
            </form>
        </div>
        <nav aria-label="@Data.SectionsTitle" class="no-scrollbar -mx-4 mt-8 flex gap-2 overflow-x-auto px-4 pb-1">
            @foreach (var chip in _sectionChips)
            {
                <a href="@chip.Url" class="@ChipClass">@Text(chip.Name)</a>
            }
        </nav>
    </div>
</section>

@if (_featured.Count > 0)
{
    <section class="container-page py-12 md:py-16">
        <div>
            <p class="font-script text-2xl text-accent">@Text(Data.Featured.Eyebrow)</p>
            <h2 class="font-serif text-3xl leading-tight text-accent-strong md:text-4xl">@Text(Data.Featured.Title)</h2>
        </div>
        <div class="mt-8">
            <ProductRail Items="_featured"/>
        </div>
    </section>
}

@if (_latest.Count > 0)
{
    <section class="container-page py-12 md:py-16">
        <div class="flex items-end justify-between gap-6">
            <div>
                <p class="font-script text-2xl text-accent">@Text(Data.Latest.Eyebrow)</p>
                <h2 class="font-serif text-3xl leading-tight text-accent-strong md:text-4xl">@Text(Data.Latest.Title)</h2>
            </div>
            <a href="@_allProductsUrl" class="hidden shrink-0 text-base text-accent-strong underline-offset-4 hover:text-accent hover:underline md:inline">@Text(Data.AllProductsLabel)</a>
        </div>
        <div class="mt-8">
            <ProductRail Items="_latest"/>
        </div>
    </section>
}

@foreach (var block in _sections)
{
    <section class="@block.SectionClass">
        <div class="container-page py-12 md:py-16">
            <div>
                <p class="font-script text-2xl text-accent">@Text(Data.SectionEyebrow)</p>
                <h2 class="font-serif text-3xl leading-tight text-accent-strong md:text-4xl">@Text(block.Title)</h2>
                <p class="mt-3 max-w-2xl text-muted">@Text(block.Subtitle)</p>
            </div>
            <div class="mt-8 flex flex-col gap-6">
                @foreach (var row in block.Rows)
                {
                    <ProductRail Items="row"/>
                }
            </div>
            <div class="mt-8 text-center">
                <a href="@block.Url" class="btn-outline">@Text(Data.MoreLabel)</a>
            </div>
        </div>
    </section>
}

<section class="bg-success-soft">
    <div class="container-page py-12 md:py-16">
        <div>
            <p class="font-script text-2xl text-accent">@Text(Data.Categories.Eyebrow)</p>
            <h2 class="font-serif text-3xl leading-tight text-accent-strong md:text-4xl">@Text(Data.CategoriesTitle)</h2>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
            @foreach (var category in _categories)
            {
                <a href="@category.Url" class="group flex items-center gap-4 rounded-2xl bg-surface p-3 transition hover:shadow-md">
                    <img src="@category.ImageUrl" alt="" loading="lazy" class="h-16 w-16 shrink-0 rounded-xl object-cover md:h-20 md:w-20"/>
                    <span>
                        <span class="block font-serif text-lg leading-tight text-accent-strong group-hover:text-accent md:text-xl">@Text(category.Name)</span>
                        <span class="mt-1 block text-sm text-muted">@Text(category.CountLabel)</span>
                    </span>
                </a>
            }
        </div>
    </div>
</section>

<div class="container-page py-12 text-center md:py-16">
    <a href="@_allProductsUrl" class="btn-outline">@Text(Data.AllProductsLabel)</a>
</div>

@code {
    private const int FeaturedCount = 10;
    private const int LatestCount = 10;
    private const int SectionItemCount = 10;
    private const int RowCapacity = 5;
    private const int MinimumOverflowRowCount = 2;
    private const string PlainSection = "";
    private const string TintedSection = "bg-surface-alt";
    private const string ChipClass = "inline-flex min-h-11 shrink-0 items-center rounded-full border border-border bg-surface px-5 text-base text-accent-strong transition hover:border-accent";

    private sealed record Link(string Name, string Url);

    private sealed record CategoryLink(string Name, string Url, string ImageUrl, string CountLabel);

    private sealed record SectionRows(string SectionClass, string Title, string Subtitle, string Url, List<IReadOnlyList<ProductCardModel>> Rows);

    private static readonly (string Title, string Eyebrow, string SearchPlaceholder, string SearchLabel, string AllLabel, string AllProductsLabel, string MoreLabel, string SectionEyebrow, string SectionsTitle, string CategoriesTitle, (string Eyebrow, string Title) Featured, (string Eyebrow, string Title) Categories, (string Eyebrow, string Title) Latest, (string Title, string Description) Seo) Data = (
        "Loja",
        "Tudo num só lugar",
        "Procurar chás, cafés ou cosméticos",
        "Procurar",
        "Tudo",
        "Ver todos os produtos",
        "Ver mais",
        "Escolhidos para si",
        "Secções da loja",
        "Comprar por categoria",
        ("Os favoritos da casa", "Em destaque"),
        ("Encontre depressa", "Comprar por categoria"),
        ("Acabados de chegar", "Novidades"),
        ("Loja | Unayka", "Chás, cafés e cosméticos naturais selecionados pela Unayka. Pague com M-Pesa, e-Mola, mKesh ou cartão e levante na loja ou receba em Maputo."));

    private IReadOnlyList<ProductCardModel> _featured = [];
    private IReadOnlyList<ProductCardModel> _latest = [];
    private List<Link> _sectionChips = [];
    private List<SectionRows> _sections = [];
    private List<CategoryLink> _categories = [];
    private string _allProductsUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _featured = await Catalog.FeaturedAsync(FeaturedCount);
        _latest = await Catalog.NewArrivalsAsync(LatestCount);
        _allProductsUrl = ToUrl(StoreUrls.AllProducts);
        var sections = await Catalog.SectionsAsync();
        _sectionChips = sections
            .Select(section => new Link(section.Name, ToUrl(StoreUrls.Section(section.Slug))))
            .Prepend(new Link(Data.AllLabel, _allProductsUrl))
            .ToList();
        var sectionRows = new List<SectionRows>();
        foreach (var section in sections)
        {
            var items = await Catalog.BySectionAsync(section.Slug, SectionItemCount);
            if (items.Count > 0)
            {
                var sectionClass = sectionRows.Count % 2 == 0 ? TintedSection : PlainSection;
                sectionRows.Add(new SectionRows(sectionClass, section.Name, section.Description, ToUrl(StoreUrls.Section(section.Slug)), ArrangeIntoRows(items)));
            }
        }

        _sections = sectionRows;
        _categories =(await Catalog.CategoriesAsync())
            .Select(category => new CategoryLink(category.Name, ToUrl(StoreUrls.Category(category.Slug)), ToUrl(category.ImageUrl), CountLabel(category.ProductCount)))
            .ToList();
    }

    private static List<IReadOnlyList<ProductCardModel>> ArrangeIntoRows(IReadOnlyList<ProductCardModel> items)
    {
        var overflowCount = items.Count - RowCapacity;
        if (overflowCount < MinimumOverflowRowCount)
        {
            return [items.ToList()];
        }

        return [items.Take(RowCapacity).ToList(), items.Skip(RowCapacity).ToList()];
    }

    private static string CountLabel(int count) => count == 1 ? "1 produto" : $"{count} produtos";
}
