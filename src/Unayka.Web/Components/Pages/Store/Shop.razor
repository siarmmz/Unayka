@page "/loja"
@using Unayka.Web.Components.Store
@inject ICatalogQuery Catalog

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<section class="border-b border-sand bg-cream">
    <div class="container-page py-16 text-center md:py-20">
        <p class="font-script text-3xl text-clay md:text-4xl">@Text(Data.Eyebrow)</p>
        <h1 class="mt-2 text-5xl md:text-6xl">@Text(Data.Title)</h1>
        <p class="mx-auto mt-5 max-w-xl text-stone">@Text(Data.Subtitle)</p>
    </div>
</section>

@if (_featured.Count > 0)
{
    <section class="py-16 md:py-24">
        <div class="container-page flex items-end justify-between gap-6">
            <SectionHeading Eyebrow="@Data.Featured.Eyebrow" Title="@Data.Featured.Title"/>
            <a href="@_allProductsUrl" class="shrink-0 text-sm text-espresso underline-offset-4 hover:text-clay hover:underline">@Text(Data.MoreLabel)</a>
        </div>
        <div class="group mt-10 overflow-hidden motion-reduce:overflow-x-auto">
            <div class="flex w-max animate-marquee gap-6 px-4 group-hover:[animation-play-state:paused] motion-reduce:animate-none">
                @foreach (var item in _marquee)
                {
                    <div class="w-56 shrink-0 md:w-64">
                        <ProductCard Model="item"/>
                    </div>
                }
            </div>
        </div>
    </section>
}

@foreach (var row in _rows)
{
    <ProductRowSection Eyebrow="@row.Eyebrow" Title="@row.Title" Subtitle="@row.Subtitle" Url="@row.Url" MoreLabel="@Data.MoreLabel" Items="row.Items" Tinted="row.Tinted"/>
}

@code {
    private const int FeaturedCount = 10;
    private const int RowItemCount = 8;

    private sealed record ShowroomRow(string Eyebrow, string Title, string Subtitle, string Url, bool Tinted, IReadOnlyList<ProductCardModel> Items);

    private static readonly (string Title, string Eyebrow, string Subtitle, string MoreLabel, (string Eyebrow, string Title) Featured, (string Eyebrow, string Title, string Subtitle) Teas, (string Eyebrow, string Title, string Subtitle) Cosmetics, (string Title, string Description) Seo) Data = (
        "A loja",
        "Escolhido com calma",
        "Chás de plantas, cafés da casa e cosméticos naturais. Levante na loja ou receba em Maputo.",
        "Ver mais",
        ("Os favoritos da casa", "Destaques"),
        ("Da planta à chávena", "Chás", "Chás de plantas, infusões e os nossos cafés, quentes, gelados ou para casa."),
        ("Feito de natureza", "Cosméticos naturais", "Pomadas, cremes e óleos de manteigas e plantas naturais."),
        ("Loja | Unayka", "Chás, cafés e cosméticos naturais selecionados pela Unayka. Pague com M-Pesa, e-Mola ou mKesh e levante na loja ou receba em Maputo."));

    private List<ProductCardModel> _featured = [];
    private List<ProductCardModel> _marquee = [];
    private List<ShowroomRow> _rows = [];
    private string _allProductsUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _featured = (await Catalog.FeaturedAsync(FeaturedCount)).ToList();
        _marquee = [.. _featured, .. _featured];
        _allProductsUrl = ToUrl(StoreUrls.AllProducts);
        _rows =
        [
            await BuildRowAsync(Data.Teas, CategoryKind.Tea, StoreUrls.Teas, false),
            await BuildRowAsync(Data.Cosmetics, CategoryKind.Cosmetic, StoreUrls.Cosmetics, true),
        ];
    }

    private async Task<ShowroomRow> BuildRowAsync((string Eyebrow, string Title, string Subtitle) text, CategoryKind kind, string url, bool tinted)
    {
        var page = await Catalog.SearchAsync(new ProductSearch(Kind: kind, Sort: ProductSort.BestSellers));
        return new ShowroomRow(text.Eyebrow, text.Title, text.Subtitle, url, tinted, page.Items.Take(RowItemCount).ToList());
    }
}
