@page "/conta/entrar"
@using Unayka.Web.Endpoints.Account

<SeoComponent Title="@Texts.SeoTitle" Description="@Texts.SeoDescription"/>

<section class="grid min-h-[calc(100vh-8rem)] lg:grid-cols-2">
    <div class="relative hidden lg:block">
        <img src="@LoginImageUrl" alt="" class="absolute inset-0 h-full w-full object-cover"/>
        <div class="absolute inset-0 bg-gradient-to-t from-paper/90 via-paper/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-14">
            <p class="max-w-md font-script text-5xl leading-tight text-espresso">@Text(Texts.Quote)</p>
        </div>
    </div>

    <div class="flex items-center justify-center px-4 py-14 sm:px-10">
        <div class="w-full max-w-md space-y-12">
            <header>
                <p class="font-script text-3xl text-clay">@Text(Texts.Eyebrow)</p>
                <h1 class="mt-1 font-serif text-5xl text-espresso">@Text(Texts.Title)</h1>
                <p class="mt-4 text-stone">@Text(Texts.Intro)</p>
            </header>

            <div class="space-y-4">
                @if (_customerError is not null)
                {
                    <p role="alert" class="rounded-xl bg-rose-soft px-4 py-3 text-sm text-red-700">@Text(_customerError)</p>
                }
                @foreach (var provider in _providers)
                {
                    <a href="@provider.Url" class="flex min-h-14 w-full items-center justify-center gap-3 rounded-full border border-sand bg-white px-6 text-base font-medium text-espresso transition hover:border-clay hover:bg-cream">@Text(provider.Label)</a>
                }
                @if (_showMockNote)
                {
                    <p class="rounded-xl bg-sage-soft px-4 py-3 text-sm text-espresso">@Text(Texts.MockNote)</p>
                }
                <p class="text-sm text-stone">@Text(Texts.Privacy)</p>
            </div>

            <details class="rounded-2xl border border-sand bg-cream/60 p-5" open="@_staffOpen">
                <summary class="cursor-pointer font-serif text-xl text-espresso">@Text(Texts.StaffTitle)</summary>
                <form method="post" action="@Texts.StaffAction" class="mt-5 space-y-5">
                    <AntiforgeryToken/>
                    <input type="hidden" name="returnUrl" value="@_returnUrl"/>
                    @if (_staffError is not null)
                    {
                        <p role="alert" class="rounded-xl bg-rose-soft px-4 py-3 text-sm text-red-700">@Text(_staffError)</p>
                    }
                    <div>
                        <label for="email" class="field-label">@Text(Texts.EmailLabel)</label>
                        <input id="email" name="email" type="email" autocomplete="username" required class="field"/>
                    </div>
                    <div>
                        <label for="password" class="field-label">@Text(Texts.PasswordLabel)</label>
                        <input id="password" name="password" type="password" autocomplete="current-password" required class="field"/>
                    </div>
                    <button type="submit" class="btn-outline w-full">@Text(Texts.StaffButton)</button>
                </form>
            </details>
        </div>
    </div>
</section>

@code {
    private sealed record LoginTexts(
        string SeoTitle, string SeoDescription, string Quote, string Eyebrow, string Title, string Intro,
        string MockNote, string Privacy, string StaffTitle, string EmailLabel, string PasswordLabel, string StaffButton, string StaffAction);

    private sealed record ProviderLink(string Label, string Url);

    private static readonly LoginTexts Texts = new(
        "Entrar | Unayka",
        "Entre na sua conta Unayka com o Google ou o Facebook.",
        "Natural, simples e perto de si.",
        "Bem-vinda, bem-vindo",
        "Entrar",
        "Use a sua conta Google ou Facebook. Não precisa de palavra-passe nova e, se for a primeira vez, criamos a conta por si.",
        "Modo de teste: a entrada é simulada até as chaves reais estarem configuradas.",
        "Usamos apenas o seu nome e email para identificar a conta.",
        "Acesso da equipa",
        "Email",
        "Palavra-passe",
        "Entrar na administração",
        "/conta/entrar/equipa");

    private static readonly Dictionary<string, string> ProviderLabels = new()
    {
        [ExternalProviders.Google] = "Continuar com Google",
        [ExternalProviders.Facebook] = "Continuar com Facebook",
    };

    private static readonly Dictionary<string, string> ErrorMessages = new()
    {
        [nameof(AccountOutcome.InvalidIdentity)] = "Não foi possível entrar. Tente novamente.",
        [nameof(AccountOutcome.InvalidCredentials)] = "Email ou palavra-passe incorretos.",
        [nameof(AccountOutcome.LockedOut)] = "Demasiadas tentativas falhadas. Tente novamente dentro de alguns minutos.",
    };

    private static readonly string[] StaffErrors = [nameof(AccountOutcome.InvalidCredentials), nameof(AccountOutcome.LockedOut)];

    [Parameter, SupplyParameterFromQuery(Name = AccountEndpoints.ErrorKey)]
    public string? Error { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = AccountEndpoints.ReturnUrlKey)]
    public string? ReturnUrl { get; set; }

    private static readonly string LoginImageUrl = ToUrl(SiteImages.LoginUrl);
    private List<ProviderLink> _providers = [];
    private bool _showMockNote;
    private bool _staffOpen;
    private string _returnUrl = string.Empty;
    private string? _customerError;
    private string? _staffError;

    protected override void OnParametersSet()
    {
        _returnUrl = ReturnUrl ?? string.Empty;
        var available = ExternalProviders.All.Where(ExternalProviders.IsAvailable).ToList();
        _providers = available.Select(provider => new ProviderLink(ProviderLabels[provider], ToUrl(AccountEndpoints.ExternalUrl(provider, ReturnUrl)))).ToList();
        _showMockNote = available.Any(ExternalProviders.IsMocked);

        var message = Error is not null && ErrorMessages.TryGetValue(Error, out var found) ? found : null;
        var isStaffError = Error is not null && StaffErrors.Contains(Error);
        _staffError = isStaffError ? message : null;
        _customerError = isStaffError ? null : message;
        _staffOpen = isStaffError;
    }
}
