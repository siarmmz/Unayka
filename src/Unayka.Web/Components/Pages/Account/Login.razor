@page "/conta/entrar"
@using Unayka.Web.Endpoints
@inject ISiteContent Site

<SeoComponent Title="@_seo.Title" Description="@_seo.Body"/>

<section class="grid min-h-[calc(100vh-8rem)] lg:grid-cols-2">
    <div class="relative hidden lg:block">
        <img src="@_imageUrl" alt="" class="absolute inset-0 h-full w-full object-cover"/>
        <div class="absolute inset-0 bg-gradient-to-t from-surface/90 via-surface/20 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-14">
            <p class="max-w-md font-script text-5xl leading-tight text-accent-strong">@Text(_hero.Title)</p>
        </div>
    </div>

    <div class="flex items-center justify-center px-4 py-14 sm:px-10">
        <div class="w-full max-w-md space-y-12">
            <header>
                <p class="font-script text-3xl text-accent">@Text(Texts.Eyebrow)</p>
                <h1 class="mt-1 font-serif text-5xl text-accent-strong">@Text(Texts.Title)</h1>
                <p class="mt-4 text-muted">@Text(Texts.Intro)</p>
            </header>

            <div class="space-y-4">
                @if (_customerError is not null)
                {
                    <p role="alert" class="rounded-xl bg-accent-soft px-4 py-3 text-sm text-danger">@Text(_customerError)</p>
                }
                @foreach (var provider in _providers)
                {
                    <a href="@provider.Url" class="@provider.CssClass">
                        <i class="bi @provider.Icon shrink-0 text-xl"></i>
                        <span>@Text(provider.Label)</span>
                    </a>
                }
                <p class="text-sm text-muted">@Text(Texts.Privacy)</p>
            </div>

            <details class="rounded-2xl border border-border bg-surface-alt/60 p-5" open="@_staffOpen">
                <summary class="cursor-pointer font-serif text-xl text-accent-strong">@Text(Texts.StaffTitle)</summary>
                <form method="post" action="@Texts.StaffAction" class="mt-5 space-y-5">
                    <AntiforgeryToken/>
                    <input type="hidden" name="returnUrl" value="@_returnUrl"/>
                    @if (_staffError is not null)
                    {
                        <p role="alert" class="rounded-xl bg-accent-soft px-4 py-3 text-sm text-danger">@Text(_staffError)</p>
                    }
                    <div>
                        <label for="email" class="field-label">@Text(Texts.EmailLabel)</label>
                        <input id="email" name="email" type="email" autocomplete="username" required class="field"/>
                    </div>
                    <div>
                        <label for="password" class="field-label">@Text(Texts.PasswordLabel)</label>
                        <input id="password" name="password" type="password" autocomplete="current-password" required class="field"/>
                    </div>
                    <button type="submit" class="btn-outline w-full">@Text(Texts.StaffButton)</button>
                </form>
            </details>
        </div>
    </div>
</section>

@code {
    private sealed record LoginTexts(
        string Eyebrow, string Title, string Intro, string Privacy, string StaffTitle, string EmailLabel, string PasswordLabel, string StaffButton, string StaffAction);

    private sealed record ProviderLink(string Label, string Url, string Icon, string CssClass);

    private sealed record ProviderStyle(string Label, string Icon, string CssClass);

    private const string ButtonBase = "flex min-h-14 w-full items-center justify-center gap-3 rounded-full px-6 text-base font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 ";
    private const string GoogleButton = ButtonBase + "border border-brand-google-border bg-brand-google text-brand-google-text hover:bg-surface-alt";
    private const string FacebookButton = ButtonBase + "bg-brand-facebook text-brand-facebook-text hover:opacity-90";

    private static readonly LoginTexts Texts = new(
        "Bem-vinda, bem-vindo",
        "Entrar",
        "Use a sua conta Google ou Facebook. Não precisa de palavra-passe nova e, se for a primeira vez, criamos a conta por si.",
        "Usamos apenas o seu nome e email para identificar a conta.",
        "Acesso da equipa",
        "Email",
        "Palavra-passe",
        "Entrar na administração",
        "/conta/entrar/equipa");

    private static readonly Dictionary<string, ProviderStyle> ProviderStyles = new()
    {
        [ExternalProviders.Google] = new("Continuar com Google", "bi-google", GoogleButton),
        [ExternalProviders.Facebook] = new("Continuar com Facebook", "bi-facebook", FacebookButton),
    };

    private static readonly Dictionary<string, string> ErrorMessages = new()
    {
        [nameof(AccountOutcome.InvalidIdentity)] = "Não foi possível entrar. Tente novamente.",
        [nameof(AccountOutcome.InvalidCredentials)] = "Email ou palavra-passe incorretos.",
        [nameof(AccountOutcome.LockedOut)] = "Demasiadas tentativas falhadas. Tente novamente dentro de alguns minutos.",
        [AccountEndpoints.ExternalUnavailableError] = "Esta forma de entrar não está disponível de momento.",
    };

    private static readonly string[] StaffErrors = [nameof(AccountOutcome.InvalidCredentials), nameof(AccountOutcome.LockedOut)];

    [Parameter, SupplyParameterFromQuery(Name = AccountEndpoints.ErrorKey)]
    public string? Error { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = AccountEndpoints.ReturnUrlKey)]
    public string? ReturnUrl { get; set; }

    private SiteBlockView _seo = new SitePage([]).One(SitePlacements.Seo);
    private SiteBlockView _hero = new SitePage([]).One(SitePlacements.Hero);
    private string _imageUrl = string.Empty;
    private List<ProviderLink> _providers = [];
    private bool _staffOpen;
    private string _returnUrl = string.Empty;
    private string? _customerError;
    private string? _staffError;

    protected override async Task OnInitializedAsync()
    {
        var page = await Site.PageAsync(SitePages.Login);
        _seo = page.One(SitePlacements.Seo);
        _hero = page.One(SitePlacements.Hero);
        _imageUrl = ToUrl(_hero.ImageUrl);
    }

    protected override void OnParametersSet()
    {
        _returnUrl = ReturnUrl ?? string.Empty;
        _providers = ExternalProviders.All
            .Select(provider => new ProviderLink(ProviderStyles[provider].Label, ToUrl(AccountEndpoints.ExternalUrl(provider, ReturnUrl)), ProviderStyles[provider].Icon, ProviderStyles[provider].CssClass))
            .ToList();

        var message = Error is not null && ErrorMessages.TryGetValue(Error, out var found) ? found : null;
        var isStaffError = Error is not null && StaffErrors.Contains(Error);
        _staffError = isStaffError ? message : null;
        _customerError = isStaffError ? null : message;
        _staffOpen = isStaffError;
    }
}
