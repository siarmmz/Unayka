@page "/"
@using Unayka.Web.Components.Store
@inject ICatalogQuery Catalog

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description" StructuredDataJson="@_structuredData"/>

<unayka-carousel class="relative block h-[78vh] min-h-[32rem] overflow-hidden bg-cream">
    @foreach (var slide in _slides)
    {
        <div data-slide class="@SlideClass" data-active="@slide.ActiveMarker">
            <img src="@slide.ImageUrl" alt="" class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover transition-transform duration-[6000ms] ease-out group-data-[active]:scale-100"/>
            <div class="absolute inset-0 -z-10 bg-gradient-to-r from-paper via-paper/80 to-paper/10"></div>
            <div class="container-page flex h-full items-center">
                <div class="max-w-xl translate-y-4 transition duration-700 group-data-[active]:translate-y-0">
                    <p class="font-script text-3xl text-clay md:text-4xl">@Text(slide.Eyebrow)</p>
                    <h1 class="mt-2 text-5xl leading-[1.05] md:text-6xl">@Text(slide.Title)</h1>
                    <p class="mt-5 text-lg text-ink">@Text(slide.Text)</p>
                    <a href="@slide.Url" class="btn-primary mt-8">@Text(slide.ActionLabel)</a>
                </div>
            </div>
        </div>
    }
    <div class="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 gap-1 rounded-full bg-paper/85 px-2 shadow-sm">
        @foreach (var slide in _slides)
        {
            <button type="button" data-bullet aria-label="@slide.Eyebrow" class="group/bullet flex h-11 items-center px-1.5">
                <span class="block h-2.5 w-2.5 rounded-full bg-espresso/35 transition-all duration-500 group-hover/bullet:bg-espresso/60 group-aria-[current=true]/bullet:w-8 group-aria-[current=true]/bullet:bg-espresso"></span>
            </button>
        }
    </div>
</unayka-carousel>

@foreach (var row in _rows)
{
    <ProductRowSection Eyebrow="@row.Eyebrow" Title="@row.Title" Subtitle="@row.Subtitle" Url="@row.Url" MoreLabel="@Data.MoreLabel" Items="row.Items" Tinted="row.Tinted"/>
}

<section class="container-page py-16 md:py-20">
    <SectionHeading Eyebrow="@Data.Steps.Eyebrow" Title="@Data.Steps.Title" Centered="true"/>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
        @foreach (var step in _steps)
        {
            <li class="rounded-3xl bg-cream p-8 text-center">
                <p class="font-script text-4xl text-clay">@Text(step.Number)</p>
                <h3 class="mt-2 text-2xl">@Text(step.Title)</h3>
                <p class="mt-3 text-stone">@Text(step.Text)</p>
            </li>
        }
    </ol>
</section>

<section class="bg-sage-soft">
    <div class="container-page grid items-center gap-10 py-16 md:grid-cols-2 md:gap-16 md:py-20">
        <img src="@_storyUrl" alt="@Data.Story.ImageAlt" loading="lazy" class="aspect-[4/5] w-full rounded-3xl object-cover"/>
        <div>
            <SectionHeading Eyebrow="@Data.Story.Eyebrow" Title="@Data.Story.Title"/>
            @foreach (var paragraph in Data.Story.Paragraphs)
            {
                <p class="mt-6 text-lg leading-relaxed text-ink">@Text(paragraph)</p>
            }
            <a href="@_aboutUrl" class="btn-outline mt-10">@Text(Data.Story.ActionLabel)</a>
        </div>
    </div>
</section>

<section class="container-page py-16 md:py-20">
    <div class="flex flex-col items-center gap-6 rounded-3xl border border-sand bg-paper p-8 text-center md:flex-row md:justify-between md:p-12 md:text-left">
        <div>
            <p class="font-script text-3xl text-clay">@Text(Data.Contact.Eyebrow)</p>
            <h2 class="mt-1 text-3xl md:text-4xl">@Text(Data.Contact.Title)</h2>
            <p class="mt-3 max-w-lg text-stone">@Text(Data.Contact.Text)</p>
        </div>
        <a href="@_contactUrl" class="btn-primary shrink-0">@Text(Data.Contact.ActionLabel)</a>
    </div>
</section>

@code {
    private const int RowItemCount = 4;
    private const string AboutPath = "/about";
    private const string ContactPath = "/contact";
    private const string SlideClass = "group absolute inset-0 isolate opacity-0 transition-opacity duration-1000 data-[active]:opacity-100 data-[active]:z-10";

    private sealed record Slide(string? ActiveMarker, string Eyebrow, string Title, string Text, string ActionLabel, string Url, string ImageUrl);

    private sealed record Row(string Eyebrow, string Title, string Subtitle, string Url, bool Tinted, IReadOnlyList<ProductCardModel> Items);

    private sealed record Step(string Number, string Title, string Text);

    private static readonly
        (
        (string Eyebrow, string Title, string Text, string ActionLabel)[] Slides,
        string MoreLabel,
        (string Eyebrow, string Title, string Subtitle) Featured,
        (string Eyebrow, string Title, string Subtitle) Teas,
        (string Eyebrow, string Title, string Subtitle) Cosmetics,
        (string Eyebrow, string Title, (string Title, string Text)[] Items) Steps,
        (string Eyebrow, string Title, string[] Paragraphs, string ActionLabel, string ImageAlt) Story,
        (string Eyebrow, string Title, string Text, string ActionLabel) Contact,
        (string Title, string Description) Seo,
        string StoreDescription,
        string[] OpeningHours) Data = (
        [
            ("Chás naturais", "Chás de plantas, para todos os dias", "Folhas e flores secas ao sol, com o sabor de sempre. O café também está cá.", "Ver chás"),
            ("Cosméticos naturais", "Cuidar da pele com o que a terra dá", "Pomadas, cremes e óleos de manteigas e plantas naturais.", "Ver cosméticos"),
            ("Compra fácil", "Encomende do telemóvel em poucos passos", "Pague com M-Pesa, e-Mola, mKesh ou cartão e levante na loja ou receba em casa.", "Ir à loja"),
        ],
        "Ver mais",
        ("Os favoritos da casa", "Destaques", "Os produtos que os nossos clientes mais procuram."),
        ("Da planta à chávena", "Chás", "Chás de plantas, infusões e os nossos cafés."),
        ("Feito de natureza", "Cosméticos naturais", "Pomadas, cremes e óleos para a pele e o cabelo."),
        (
            "Simples",
            "Como funciona",
            [
                ("Escolha", "Junte ao carrinho os produtos de que gosta, com um toque."),
                ("Pague", "Pague com M-Pesa, e-Mola, mKesh ou cartão Visa e Mastercard."),
                ("Receba", "Levante na loja quando estiver pronto ou receba em casa, em Maputo."),
            ]),
        (
            "Ingredientes naturais",
            "Plantas, folhas e manteigas, sem segredos",
            [
                "Os nossos chás são feitos de folhas, flores e raízes secas ao sol, sem aromas artificiais.",
                "Os cosméticos usam manteigas e óleos naturais, como a moringa e o karité. Em cada produto mostramos a composição completa.",
            ],
            "Conhecer a Unayka",
            "Folhas de chá e plantas naturais"),
        ("Fale connosco", "Tem alguma dúvida?", "Ajudamos a escolher o chá ou o cosmético certo para si.", "Contactar"),
        ("Unayka | Chás e cosméticos naturais", "Loja online de chás e cosméticos naturais em Maputo. Encomende, pague com M-Pesa, e-Mola, mKesh ou cartão e levante na loja ou receba em casa."),
        "Loja online de chás e cosméticos naturais em Maputo.",
        ["Mo-Fr 07:30-19:00", "Sa 08:00-17:00", "Su 09:00-14:00"]);

    private static readonly string[] SlideImages = [SiteImages.TeaBannerUrl, SiteImages.CosmeticsBannerUrl, SiteImages.HeroUrl];

    private List<Slide> _slides = [];
    private List<Row> _rows = [];
    private List<Step> _steps = [];
    private string _structuredData = string.Empty;
    private string _storyUrl = string.Empty;
    private string _aboutUrl = string.Empty;
    private string _contactUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        string[] slideUrls = [StoreUrls.Teas, StoreUrls.Cosmetics, StoreUrls.Shop];
        _slides = Data.Slides
            .Select((slide, index) => new Slide(index == 0 ? string.Empty : null, slide.Eyebrow, slide.Title, slide.Text, slide.ActionLabel, ToUrl(slideUrls[index]), ToUrl(SlideImages[index])))
            .ToList();
        _rows =
        [
            new Row(Data.Featured.Eyebrow, Data.Featured.Title, Data.Featured.Subtitle, StoreUrls.Shop, false, await Catalog.FeaturedAsync(RowItemCount)),
            new Row(Data.Teas.Eyebrow, Data.Teas.Title, Data.Teas.Subtitle, StoreUrls.Teas, true, await TopAsync(CategoryKind.Tea)),
            new Row(Data.Cosmetics.Eyebrow, Data.Cosmetics.Title, Data.Cosmetics.Subtitle, StoreUrls.Cosmetics, false, await TopAsync(CategoryKind.Cosmetic)),
        ];
        _steps = Data.Steps.Items.Select((step, index) => new Step((index + 1).ToString(System.Globalization.CultureInfo.InvariantCulture), step.Title, step.Text)).ToList();
        _storyUrl = ToUrl(SiteImages.StoryUrl);
        _aboutUrl = ToUrl(AboutPath);
        _contactUrl = ToUrl(ContactPath);
        _structuredData = StoreStructuredData.Store(StoreStructuredData.Root(Navigation.BaseUri), SiteImages.HeroUrl, Data.StoreDescription, Data.OpeningHours);
    }

    private async Task<IReadOnlyList<ProductCardModel>> TopAsync(CategoryKind kind)
    {
        var page = await Catalog.SearchAsync(new ProductSearch(Kind: kind, Sort: ProductSort.BestSellers));
        return page.Items.Take(RowItemCount).ToList();
    }
}
