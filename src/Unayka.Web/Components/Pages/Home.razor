@page "/"

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<h1 class="font-script text-5xl leading-tight">@Text(Data.Title)</h1>
<p class="mt-6 text-lg">@Text(Data.Intro)</p>

<ul class="mt-10 grid gap-6 sm:grid-cols-2">
    @foreach (var service in Data.Services)
    {
        <li class="border-t border-sand pt-4">
            <h2 class="text-xl">@Text(service.Title)</h2>
            <p class="mt-2 text-clay">@Text(service.Description)</p>
        </li>
    }
</ul>

<a href="@ToUrl(Data.ServicesUrl)" class="inline-block mt-10 border-b border-ink pb-1">@Text(Data.ServicesLabel)</a>

@code {
    private static readonly (string Title, string Intro, string ServicesLabel, string ServicesUrl, (string Title, string Description)[] Services, (string Title, string Description) Seo) Data = (
        "Cafés e cosméticos, com calma",
        "A Unayka reúne cafés preparados com cuidado e cosméticos selecionados num espaço de salão moderno. Pode pedir online ou passar pelo balcão.",
        "Ver todos os serviços",
        "/services",
        [
            ("Cafés", "Cafés preparados na hora para beber no local ou levar."),
            ("Cosméticos", "Uma seleção cuidada de produtos para a pele e o cabelo."),
            ("Pedidos online", "Escolha em casa e levante na loja quando estiver pronto."),
            ("Pagamento móvel", "Pague com a sua carteira móvel, no telemóvel."),
        ],
        ("Unayka | Cafés e cosméticos", "Loja de cafés e cosméticos com ambiente de salão moderno. Peça online ou no balcão.")
    );
}
