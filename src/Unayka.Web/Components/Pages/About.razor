@page "/about"

<SeoComponent Title="@Data.Seo.Title" Description="@Data.Seo.Description"/>

<PageHero Title="@Data.Title" Eyebrow="@Data.Eyebrow" Subtitle="@Data.Subtitle" ImageUrl="@Data.HeroImage"/>

<section class="container-page grid items-center gap-12 py-20 lg:grid-cols-2">
    <img src="@StoryImage" alt="@Data.StoryAlt" loading="lazy" class="aspect-[4/5] w-full rounded-3xl object-cover"/>
    <div class="space-y-6">
        <SectionHeading Eyebrow="@Data.StoryEyebrow" Title="@Data.StoryTitle"/>
        @foreach (var paragraph in Data.Paragraphs)
        {
            <p class="text-lg leading-relaxed text-muted">@Text(paragraph)</p>
        }
    </div>
</section>

<section class="bg-surface-alt py-20">
    <div class="container-page">
        <SectionHeading Title="@Data.ValuesTitle" Centered="true"/>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
            @foreach (var value in Data.Values)
            {
                <div class="rounded-3xl bg-surface p-8">
                    <h3 class="font-serif text-2xl">@Text(value.Title)</h3>
                    <p class="mt-3 text-muted">@Text(value.Description)</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string StoryImage = ToUrl(SiteImages.StoryUrl);

    private static readonly (string Title, string Eyebrow, string Subtitle, string HeroImage, string StoryEyebrow, string StoryTitle, string StoryAlt, string[] Paragraphs, string ValuesTitle, (string Title, string Description)[] Values, (string Title, string Description) Seo) Data = (
        "Sobre a Unayka",
        "A nossa história",
        "Chás e cosméticos naturais, escolhidos com cuidado e entregues até si.",
        SiteImages.AboutUrl,
        "Da planta até si",
        "Natural, simples e perto de si",
        "Folhas de chá e plantas naturais",
        [
            "A Unayka é uma loja de chás e cosméticos naturais. Escolhemos plantas, folhas, manteigas e óleos com origem clara e pouca transformação.",
            "Compre online em poucos passos, pague com a sua carteira móvel e levante na loja ou receba em casa, em Maputo.",
        ],
        "O que nos guia",
        [
            ("Ingredientes claros", "Mostramos a tabela nutricional dos chás e a composição dos cosméticos, sem letras pequenas."),
            ("Natural", "Plantas e matérias naturais, sem ingredientes escondidos."),
            ("Perto de si", "Peça online, levante na loja ou receba em casa em Maputo."),
        ],
        ("Sobre | Unayka", "Conheça a Unayka, loja online de chás e cosméticos naturais em Maputo.")
    );
}
