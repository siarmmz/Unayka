@using Unayka.Core.Locations
@using Unayka.Web.Components.Checkout
@using Unayka.Web.Components.Store
@inject ICatalogQuery Catalog
@inject ILocationDirectory Locations

<footer class="mt-24 border-t border-border bg-surface-alt text-muted">
    <div class="container-page grid gap-10 py-14 lg:grid-cols-6 lg:gap-12 lg:py-16">
        <div class="lg:col-span-2">
            <p class="font-script text-5xl text-accent-strong">@Text(Data.BrandName)</p>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">@Text(Data.Tagline)</p>
            <p class="mt-6 text-sm text-accent">@Text(Data.WalletNote)</p>
            <ul class="mt-3 flex flex-wrap gap-2">
                @foreach (var icon in PaymentChoices.AllIcons)
                {
                    <li><img src="@icon.Url" alt="@icon.Alt" width="40" height="40" loading="lazy" class="h-10 w-10 rounded-lg border border-border bg-surface object-contain p-0.5"/></li>
                }
            </ul>
            <ul class="mt-6 flex gap-3">
                @foreach (var link in Data.Social)
                {
                    <li>
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@link.Label" class="flex h-11 w-11 items-center justify-center rounded-full border border-border bg-surface text-accent-strong transition hover:border-accent hover:text-accent">
                            <StoreIcon Name="@link.Icon" Class="h-5 w-5"/>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <unayka-collapse class="grid md:grid-cols-3 md:gap-10 lg:col-span-4">
            @foreach (var column in _columns)
            {
                <details open class="group border-b border-border md:border-0">
                    <summary class="@SummaryClass">
                        <span>@Text(column.Title)</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition group-open:rotate-180 md:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                    </summary>
                    <ul class="space-y-1 pb-5 text-sm md:pb-0">
                        @foreach (var link in column.Links)
                        {
                            <li><a href="@link.Url" class="flex min-h-11 items-center text-muted transition hover:text-accent md:min-h-9">@Text(link.Label)</a></li>
                        }
                    </ul>
                </details>
            }
            <details open class="group border-b border-border md:border-0">
                <summary class="@SummaryClass">
                    <span>@Text(Data.ContactTitle)</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition group-open:rotate-180 md:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                </summary>
                <div class="space-y-5 pb-5 text-sm md:pb-0">
                    @foreach (var location in _locations)
                    {
                        <div>
                            <p class="font-medium text-accent-strong">@Text(location.Name)</p>
                            <p>@Text(location.Address)</p>
                            <p>@Text(location.OpeningHours)</p>
                            <ul>
                                @foreach (var contact in location.Contacts)
                                {
                                    <li><a href="@contact.Url" class="flex min-h-11 items-center text-muted transition hover:text-accent md:min-h-9">@Text(contact.Label)</a></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </details>
        </unayka-collapse>
    </div>

    <div class="border-t border-border">
        <div class="container-page py-6 text-sm text-muted">@Text(_copyright)</div>
    </div>
</footer>

@code {
    private const string SummaryClass = "flex min-h-12 cursor-pointer list-none items-center justify-between text-xs font-medium uppercase tracking-widest text-accent md:pointer-events-none md:mb-3 md:min-h-0 [&::-webkit-details-marker]:hidden";
    private const string WhatsAppBase = "https://wa.me/";
    private const string PhonePrefix = "tel:";
    private const string EmailPrefix = "mailto:";

    private sealed record FooterLink(string Label, string Url);

    private sealed record FooterColumn(string Title, IReadOnlyList<FooterLink> Links);

    private sealed record FooterLocation(string Name, string Address, string OpeningHours, IReadOnlyList<FooterLink> Contacts);

    private static readonly (string BrandName, string Tagline, string WalletNote, string ShopTitle, string AllProductsLabel, string HelpTitle, string ContactTitle, (string Label, string Url, string Icon)[] Social, (string Label, string Url)[] Help) Data = (
        "Unayka",
        "Chás e cosméticos naturais. Compre online e levante na loja.",
        "Pague com M-Pesa, e-Mola, mKesh ou cartão Visa e Mastercard.",
        "Loja",
        "Todos os produtos",
        "Ajuda",
        "Contactos",
        [
            ("Facebook", "https://www.facebook.com/unayka", StoreIcons.Facebook),
            ("Instagram", "https://www.instagram.com/unayka", StoreIcons.Instagram),
        ],
        [
            ("Como comprar", "/#como-comprar"),
            ("Levantamento", "/contacto"),
            ("Pagamentos", "/#como-comprar"),
        ]
    );

    private string _copyright = string.Empty;
    private List<FooterColumn> _columns = [];
    private List<FooterLocation> _locations = [];

    protected override async Task OnInitializedAsync()
    {
        var sections = await Catalog.SectionsAsync();
        var shopLinks = sections
            .Select(section => new FooterLink(section.Name, ToUrl(StoreUrls.Section(section.Slug))))
            .Prepend(new FooterLink(Data.AllProductsLabel, ToUrl(StoreUrls.AllProducts)))
            .ToList();
        var helpLinks = Data.Help.Select(link => new FooterLink(link.Label, ToUrl(link.Url))).ToList();
        _columns = [new FooterColumn(Data.ShopTitle, shopLinks), new FooterColumn(Data.HelpTitle, helpLinks)];
        _locations = (await Locations.ActiveAsync())
            .Select(location => new FooterLocation(
                location.Name,
                location.Address,
                location.OpeningHours,
                location.Contacts.Select(contact => new FooterLink(contact.Value, ContactUrl(contact))).ToList()))
            .ToList();
        _copyright = $"© {DateTime.UtcNow.Year} Unayka. Todos os direitos reservados.";
    }

    private static string ContactUrl(LocationContactSummary contact) => contact.Kind switch
    {
        ContactKind.Email => EmailPrefix + contact.Value,
        ContactKind.WhatsApp => WhatsAppBase + Digits(contact.Value),
        _ => PhonePrefix + "+" + Digits(contact.Value),
    };

    private static string Digits(string value) => new(value.Where(char.IsDigit).ToArray());
}
