@inherits UnaykaLayoutBase

<div class="flex min-h-screen flex-col bg-surface text-ink">
    <div class="bg-success-soft px-4 py-2 text-center text-sm text-accent-strong">@Text(Announcement)</div>
    <SiteHeader/>
    <main class="flex-1">
        @Body
    </main>
    <SiteFooter/>
    <CartAddedNotice/>
</div>

@code {
    private static readonly string Announcement = "Levantamento nas nossas lojas. Pague com carteira móvel ou cartão.";
}
