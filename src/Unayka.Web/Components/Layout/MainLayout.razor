@inherits UnaykaLayoutBase

<div class="flex min-h-screen flex-col bg-paper text-ink">
    <div class="bg-espresso px-4 py-2 text-center text-xs tracking-wide text-sand">@Text(Announcement)</div>
    <SiteHeader/>
