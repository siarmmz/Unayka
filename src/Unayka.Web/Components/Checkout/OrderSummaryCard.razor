<div class="h-fit space-y-6 rounded-3xl border border-border bg-surface-alt/60 p-8">
    <h2 class="font-serif text-2xl text-accent-strong">@Text(Texts.Title)</h2>
    <OrderLinesList Lines="Order.Lines" AllowDownloads="_allowDownloads"/>
    <dl class="space-y-3 text-sm">
        @foreach (var row in _totals)
        {
            <div class="@row.CssClass"><dt>@Text(row.Label)</dt><dd>@Text(row.Value)</dd></div>
        }
    </dl>
    @if (_notes is not null)
    {
        <p class="border-t border-border pt-5 text-sm text-muted">@Text(_notes)</p>
    }
</div>

@code {
    private sealed record SummaryTexts(string Title, string SubtotalLabel, string DiscountTemplate, string TotalLabel, string NotesTemplate);

    private sealed record TotalRow(string Label, string Value, string CssClass);

    private const string PlainRowClass = "flex justify-between text-muted";
    private const string TotalRowClass = "flex justify-between border-t border-border pt-4 font-serif text-xl text-accent-strong";

    private static readonly SummaryTexts Texts = new(
        "Resumo do pedido",
        "Subtotal",
        "Desconto ({0})",
        "Total",
        "Notas: {0}");

    [Parameter, EditorRequired]
    public OrderDetail Order { get; set; } = default!;

    [Parameter]
    public int? ViewerUserId { get; set; }

    private List<TotalRow> _totals = [];
    private bool _allowDownloads;
    private string? _notes;

    protected override void OnParametersSet()
    {
        var culture = System.Globalization.CultureInfo.InvariantCulture;
        _allowDownloads = ViewerUserId is not null && Order.UserId == ViewerUserId && OrderPayments.IsPaid(Order.Status);
        _totals = [new(Texts.SubtotalLabel, FormatMoney(Order.SubtotalMinor), PlainRowClass)];
        if (Order.DiscountMinor > 0)
        {
            _totals.Add(new(string.Format(culture, Texts.DiscountTemplate, Order.CouponCode), "-" + FormatMoney(Order.DiscountMinor), PlainRowClass));
        }

        _totals.Add(new(Texts.TotalLabel, FormatMoney(Order.TotalMinor), TotalRowClass));
        _notes = string.IsNullOrWhiteSpace(Order.Notes) ? null : string.Format(culture, Texts.NotesTemplate, Order.Notes);
    }
}
