@using Unayka.Web.Endpoints.Downloads

<div class="space-y-6">
    @foreach (var group in _groups)
    {
        <section class="space-y-2">
            <div>
                <h3 class="font-serif text-xl text-accent-strong">@Text(group.Title)</h3>
                @if (group.Detail is not null)
                {
                    <p class="text-sm text-muted">@Text(group.Detail)</p>
                }
            </div>
            <ul class="divide-y divide-border border-y border-border">
                @foreach (var row in group.Rows)
                {
                    <li class="flex items-center gap-4 py-3 text-sm">
                        <img src="@row.ImageUrl" alt="@row.Name" class="h-14 w-12 shrink-0 rounded-lg bg-surface-alt object-cover"/>
                        <div class="min-w-0 flex-1 space-y-1">
                            @if (row.ProductUrl is not null)
                            {
                                <a href="@row.ProductUrl" class="block text-accent-strong hover:text-accent">@Text(row.Name)</a>
                            }
                            @if (row.ProductUrl is null)
                            {
                                <p class="text-accent-strong">@Text(row.Name)</p>
                            }
                            <p class="text-muted">@Text(row.Quantity)</p>
                        </div>
                        <div class="flex shrink-0 flex-col items-end gap-2">
                            <span>@Text(row.Total)</span>
                            @if (row.DownloadUrl is not null)
                            {
                                <a href="@row.DownloadUrl" class="btn-outline min-h-10 px-4 py-1.5 text-sm">@Text(Texts.DownloadButton)</a>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private sealed record ListTexts(string PickupTitleTemplate, string PickupFallbackTitle, string DigitalTitle, string DigitalDetail, string QuantityTemplate, string DownloadButton);

    private sealed record LineRow(string Name, string? ProductUrl, string ImageUrl, string Quantity, string Total, string? DownloadUrl);

    private sealed record LineGroup(string Title, string? Detail, IReadOnlyList<LineRow> Rows);

    private static readonly ListTexts Texts = new(
        "Levantar em {0}",
        "Levantamento na loja",
        "Produtos digitais",
        "Sem levantamento. Descarregue na sua conta.",
        "{0} x {1}",
        "Descarregar");

    [Parameter, EditorRequired]
    public IReadOnlyList<OrderLineDetail> Lines { get; set; } = [];

    [Parameter]
    public bool AllowDownloads { get; set; }

    private List<LineGroup> _groups = [];

    protected override void OnParametersSet()
    {
        var culture = System.Globalization.CultureInfo.InvariantCulture;
        _groups = Lines
            .Where(line => !line.IsDigital)
            .GroupBy(line => line.LocationName)
            .OrderBy(group => group.Key, StringComparer.Ordinal)
            .Select(group => new LineGroup(
                group.Key is null ? Texts.PickupFallbackTitle : string.Format(culture, Texts.PickupTitleTemplate, group.Key),
                group.First().LocationAddress,
                group.Select(ToRow).ToList()))
            .ToList();
        var digital = Lines.Where(line => line.IsDigital).Select(ToRow).ToList();
        if (digital.Count > 0)
        {
            _groups.Add(new LineGroup(Texts.DigitalTitle, Texts.DigitalDetail, digital));
        }
    }

    private LineRow ToRow(OrderLineDetail line) =>
        new(
            line.ProductName,
            line.ProductSlug is null ? null : ToUrl(StoreUrls.Product(line.ProductSlug)),
            line.ImageUrl,
            string.Format(System.Globalization.CultureInfo.InvariantCulture, Texts.QuantityTemplate, line.Quantity, FormatMoney(line.UnitPriceMinor)),
            FormatMoney(line.LineTotalMinor),
            AllowDownloads && line.IsDigital ? DownloadEndpoints.UrlFor(line.ItemId) : null);
}
