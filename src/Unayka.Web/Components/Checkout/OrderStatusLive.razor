@implements IAsyncDisposable
@using Unayka.Web.Endpoints
@inject IServiceScopeFactory ScopeFactory

<div class="space-y-8 rounded-3xl border border-border p-8 sm:p-10">
    <div class="flex items-center justify-between gap-4">
        <p class="font-script text-3xl text-accent">@Text(_title)</p>
        <span class="@_badgeClass">@Text(_badgeLabel)</span>
    </div>
    <p class="text-muted">@Text(_message)</p>

    @if (_phase == Phase.Pending)
    {
        <div class="flex items-center gap-3 rounded-2xl bg-surface-alt px-5 py-4 text-sm text-accent-strong">
            <span class="h-3 w-3 animate-pulse rounded-full bg-accent"></span>
            <span>@Text(Texts.WaitingLabel)</span>
        </div>
        @if (_checkoutUrl is not null)
        {
            <a href="@_checkoutUrl" class="btn-primary">@Text(Texts.PayNowButton)</a>
        }
    }

    @if (_phase == Phase.Paid)
    {
        <div class="space-y-4">
            <p class="rounded-2xl bg-success-soft px-5 py-4 text-sm text-accent-strong">@Text(_fulfillmentNote)</p>
            @if (_downloads.Count > 0)
            {
                <ul class="space-y-3">
                    @foreach (var download in _downloads)
                    {
                        <li class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-border px-5 py-4">
                            <span class="text-accent-strong">@Text(download.Name)</span>
                            <a href="@download.Url" class="btn-primary">@Text(Texts.DownloadButton)</a>
                        </li>
                    }
                </ul>
            }
            <a href="@Texts.ShopUrl" class="btn-outline">@Text(Texts.ContinueShopping)</a>
        </div>
    }

    @if (_phase == Phase.Failed)
    {
        <div class="space-y-5">
            <p role="alert" class="rounded-2xl bg-accent-soft px-5 py-4 text-sm text-danger">@Text(_failureText)</p>
            <h2 class="font-serif text-2xl text-accent-strong">@Text(Texts.RetryTitle)</h2>
            <div>
                <label for="retry-method" class="field-label">@Text(Texts.MethodLabel)</label>
                <select id="retry-method" class="field" @bind="_retryMethod">
                    @foreach (var option in _methodOptions)
                    {
                        <option value="@option.Value">@Text(option.Label)</option>
                    }
                </select>
            </div>
            @if (_retryError is not null)
            {
                <p role="alert" class="text-sm text-danger">@Text(_retryError)</p>
            }
            <button type="button" class="btn-primary" @onclick="RetryAsync">@Text(Texts.RetryButton)</button>
        </div>
    }
</div>

@code {
    private enum Phase
    {
        Pending,
        Paid,
        Failed,
        Cancelled,
    }

    private sealed record LiveTexts(
        string PendingTitle, string PendingMessageTemplate, string WaitingLabel, string PaidTitle, string PaidMessage,
        string PickupNote, string DigitalNote, string DownloadButton, string ContinueShopping, string ShopUrl,
        string FailedTitle, string FailedMessage, string FailureTemplate, string RetryTitle, string MethodLabel,
        string RetryButton, string RetryUnavailable, string PayNowButton,
        string CancelledTitle, string CancelledMessage);

    private sealed record MethodOption(string Value, string Label);

    private static readonly LiveTexts Texts = new(
        "Conclua o pagamento",
        "Conclua o pagamento de {0} na página segura de pagamento. Esta página atualiza sozinha.",
        "A aguardar a confirmação do pagamento",
        "Pagamento confirmado",
        "Obrigado pela sua compra. Já recebemos o pagamento e vamos preparar o seu pedido.",
        "Pode levantar o pedido na loja assim que o avisarmos por mensagem.",
        "Os seus produtos digitais já podem ser descarregados, sempre que quiser, enquanto tiver sessão iniciada.",
        "Descarregar",
        "Continuar a comprar",
        StoreUrls.Shop,
        "O pagamento não passou",
        "Não conseguimos concluir o pagamento deste pedido.",
        "Motivo: {0}.",
        "Tentar novamente",
        "Método",
        "Pagar novamente",
        "Este pedido já não aceita novas tentativas de pagamento.",
        "Ir para o pagamento",
        "Pedido cancelado",
        "Este pedido foi cancelado. Se precisar de ajuda, fale connosco.");

    private const string BadgeBase = "inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ";

    private static readonly Dictionary<StatusTone, string> ToneClasses = new()
    {
        [StatusTone.Neutral] = BadgeBase + "bg-surface-alt text-muted",
        [StatusTone.Info] = BadgeBase + "bg-success-soft text-success",
        [StatusTone.Success] = BadgeBase + "bg-success-soft text-success",
        [StatusTone.Warning] = BadgeBase + "bg-warning-soft text-warning",
        [StatusTone.Danger] = BadgeBase + "bg-accent-soft text-danger",
    };

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    [Parameter, EditorRequired]
    public string Number { get; set; } = string.Empty;

    [Parameter]
    public int? ViewerUserId { get; set; }

    private sealed record DownloadLink(string Name, string Url);

    private List<DownloadLink> _downloads = [];

    private readonly CancellationTokenSource _stop = new();
    private Phase _phase = Phase.Pending;
    private List<MethodOption> _methodOptions = [];
    private string _badgeLabel = string.Empty;
    private string _badgeClass = string.Empty;
    private string? _checkoutUrl;
    private string _title = string.Empty;
    private string _message = string.Empty;
    private string _fulfillmentNote = string.Empty;
    private string _failureText = string.Empty;
    private string _retryMethod = nameof(PaymentMethod.MPesa);
    private string? _retryError;

    protected override async Task OnInitializedAsync()
    {
        await using (var scope = ScopeFactory.CreateAsyncScope())
        {
            var options = await scope.ServiceProvider.GetRequiredService<IPaymentService>().OnlineOptionsAsync();
            _methodOptions = options.Select(option => new MethodOption(option.Method.ToString(), option.Label)).ToList();
            _retryMethod = _methodOptions.FirstOrDefault()?.Value ?? _retryMethod;
        }

        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = PollAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        _stop.Dispose();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (_phase == Phase.Pending)
                {
                    await LoadAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception exception) when (exception is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

    private async Task RetryAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var payments = scope.ServiceProvider.GetRequiredService<IPaymentService>();
        var method = Enum.Parse<PaymentMethod>(_retryMethod);
        var result = await payments.RetryAsync(Number, method);
        _retryError = result.Outcome switch
        {
            PaymentRetryOutcome.NotRetryable => Texts.RetryUnavailable,
            PaymentRetryOutcome.Failed => result.FailureReason,
            _ => null,
        };
        if (result.CheckoutUrl is { } checkoutUrl && ToUrl(checkoutUrl) == checkoutUrl)
        {
            Navigation.NavigateTo(checkoutUrl, forceLoad: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        await scope.ServiceProvider.GetRequiredService<IPaymentService>().RefreshAsync(Number);
        var order = await scope.ServiceProvider.GetRequiredService<IOrderQueries>().GetByNumberAsync(Number);
        if (order is not null)
        {
            Apply(order);
        }
    }

    private void Apply(OrderDetail order)
    {
        var culture = System.Globalization.CultureInfo.InvariantCulture;
        var (label, tone) = StatusLabels.For(order.Status);
        _badgeLabel = label;
        _badgeClass = ToneClasses[tone];
        _checkoutUrl = order.Payment?.Status == PaymentStatus.Pending && order.Payment.CheckoutUrl is { } url && ToUrl(url) == url ? url : null;
        _phase = ResolvePhase(order);
        (_title, _message) = _phase switch
        {
            Phase.Paid => (Texts.PaidTitle, Texts.PaidMessage),
            Phase.Failed => (Texts.FailedTitle, Texts.FailedMessage),
            Phase.Cancelled => (Texts.CancelledTitle, Texts.CancelledMessage),
            _ => (Texts.PendingTitle, string.Format(culture, Texts.PendingMessageTemplate, FormatMoney(order.TotalMinor))),
        };
        var hasPickup = order.Lines.Any(line => !line.IsDigital);
        _fulfillmentNote = hasPickup ? Texts.PickupNote : Texts.DigitalNote;
        _downloads = order.Lines
            .Where(line => OrderPayments.CanDownload(order, line, ViewerUserId))
            .Select(line => new DownloadLink(line.ProductName, DownloadEndpoints.UrlFor(line.ItemId)))
            .ToList();
        _failureText = string.Format(culture, Texts.FailureTemplate, order.Payment?.FailureReason?.TrimEnd('.'));
    }

    private static Phase ResolvePhase(OrderDetail order)
    {
        if (order.Status == OrderStatus.Cancelled)
        {
            return Phase.Cancelled;
        }

        if (order.Status != OrderStatus.AwaitingPayment && order.Status != OrderStatus.New)
        {
            return Phase.Paid;
        }

        return order.Payment?.Status == PaymentStatus.Failed ? Phase.Failed : Phase.Pending;
    }
}
