<header class="flex flex-wrap items-end justify-between gap-4">
    <div>
        @if (Eyebrow is not null)
        {
            <p class="font-script text-2xl text-clay">@Text(Eyebrow)</p>
        }
        <h1 class="font-serif text-4xl text-espresso sm:text-5xl">@Text(Title)</h1>
        @if (Subtitle is not null)
        {
            <p class="mt-2 max-w-2xl text-sm text-stone">@Text(Subtitle)</p>
        }
    </div>
    <div class="flex flex-wrap items-center gap-3">
        @ChildContent
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
