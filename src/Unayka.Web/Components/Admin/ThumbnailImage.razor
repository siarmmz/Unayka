@if (_url is not null)
{
    <img src="@_url" alt="" loading="lazy" class="@SizeClass shrink-0 rounded-xl border border-sand object-cover"/>
}
@if (_url is null)
{
    <div class="@SizeClass shrink-0 rounded-xl border border-sand bg-cream"></div>
}

@code {
    [Parameter]
    public string? Url { get; set; }

    [Parameter]
    public string SizeClass { get; set; } = "h-12 w-12";

    private string? _url;

    protected override void OnParametersSet()
    {
        _url = string.IsNullOrWhiteSpace(Url) ? null : ToUrl(Url);
    }
}
