<div class="rounded-2xl border border-sand bg-white p-5 shadow-sm">
    <p class="text-xs font-medium uppercase tracking-widest text-stone">@Text(Label)</p>
    <p class="mt-3 font-serif text-3xl text-espresso">@Text(Value)</p>
    @if (Hint is not null)
    {
        <p class="mt-1 text-xs text-stone">@Text(Hint)</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Hint { get; set; }
}
