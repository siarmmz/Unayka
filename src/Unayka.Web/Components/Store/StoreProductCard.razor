<article class="@@container group flex h-full flex-col">
    <a href="@_url" class="block">
        <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-surface-alt">
            <unayka-fade class="isolate block h-full w-full">
                @foreach (var image in _images)
                {
                    <img src="@image.Url" alt="@image.Alt" loading="lazy" draggable="false" data-fade data-active="@image.ActiveMarker" class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-in-out data-[previous]:opacity-100 data-[active]:z-10 data-[active]:opacity-100"/>
                }
            </unayka-fade>
            <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
                @foreach (var badge in _badges)
                {
                    <span class="@badge.CssClass">@Text(badge.Label)</span>
                }
            </div>
        </div>
        <div class="mt-4 space-y-1">
            <p class="text-xs uppercase tracking-widest text-muted">@Text(Model.CategoryName)</p>
            <h3 class="font-serif text-xl text-accent-strong transition group-hover:text-accent">@Text(Model.Name)</h3>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-serif text-2xl font-bold text-price">@Text(_price)</span>
                @if (_comparePrice is not null)
                {
                    <span class="text-base text-muted line-through">@Text(_comparePrice)</span>
                    <span class="rounded-full bg-discount px-2.5 py-0.5 text-sm font-bold text-discount-text">@Text(_discount)</span>
                }
            </div>
        </div>
    </a>
    <div class="mt-auto flex items-center gap-2 pt-4">
        <form method="post" action="@Data.AddAction" class="min-w-0 flex-1">
            <AntiforgeryToken/>
            <input type="hidden" name="ProductId" value="@Model.Id"/>
            <input type="hidden" name="ReturnUrl" value="@_returnUrl"/>
            <button type="submit" disabled="@_soldOut" aria-label="@_addLabel" class="btn-compact w-full px-3">
                <i class="bi bi-bag shrink-0 text-lg"></i>
                <span aria-hidden="true" class="hidden @@[11rem]:inline @@[17rem]:hidden">@Text(_shortLabel)</span>
                <span aria-hidden="true" class="hidden @@[17rem]:inline">@Text(_addLabel)</span>
            </button>
        </form>
        <unayka-share data-url="@_absoluteUrl" data-title="@Model.Name" data-copied-label="@Data.CopiedLabel" class="relative inline-block">
            <details>
                <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-border text-lg text-accent-strong transition hover:border-accent hover:text-accent [&::-webkit-details-marker]:hidden" aria-label="@Data.ShareLabel"><i class="bi bi-share"></i></summary>
                <div class="absolute bottom-full right-0 z-30 mb-2 w-44 rounded-2xl border border-border bg-surface p-2 shadow-xl">
                    <a href="@_whatsAppUrl" target="_blank" rel="noopener noreferrer" class="@ShareItemClass"><i class="bi bi-whatsapp"></i>@Text(Data.WhatsAppLabel)</a>
                    <a href="@_facebookUrl" target="_blank" rel="noopener noreferrer" class="@ShareItemClass"><i class="bi bi-facebook"></i>@Text(Data.FacebookLabel)</a>
                    <button type="button" data-copy class="@ShareItemClass"><i class="bi bi-link-45deg"></i><span data-copy-label>@Text(Data.CopyLabel)</span></button>
                </div>
            </details>
        </unayka-share>
    </div>
</article>

@code {
    private const int MaxImages = 4;
    private const string BadgeBase = "rounded-full px-3 py-1 text-xs font-medium tracking-wide ";
    private const string NewBadgeClass = BadgeBase + "bg-accent text-surface";
    private const string PlainBadgeClass = BadgeBase + "bg-surface/90 text-accent-strong";
    private const string ShareItemClass = "flex min-h-11 w-full items-center gap-3 rounded-xl px-3 text-left text-sm text-accent-strong transition hover:bg-surface-alt";
    private const int PercentBase = 100;

    private sealed record CardImage(string Url, string Alt, string? ActiveMarker);

    private sealed record CardBadge(string Label, string CssClass);

    private static readonly (string AddAction, string AddLabel, string ShortLabel, string SoldOutLabel, string NewLabel, string FeaturedLabel, string DigitalLabel, string ShareLabel, string WhatsAppLabel, string FacebookLabel, string CopyLabel, string CopiedLabel) Data = (
        "/carrinho/adicionar",
        "Adicionar ao carrinho",
        "Adicionar",
        "Esgotado",
        "Novo",
        "Destaque",
        "Digital",
        "Partilhar",
        "WhatsApp",
        "Facebook",
        "Copiar link",
        "Link copiado");

    [Parameter, EditorRequired]
    public ProductCardModel Model { get; set; } = null!;

    private List<CardImage> _images = [];
    private List<CardBadge> _badges = [];
    private string _url = string.Empty;
    private string _returnUrl = string.Empty;
    private string _addLabel = Data.AddLabel;
    private string _shortLabel = Data.ShortLabel;
    private bool _soldOut;
    private string _price = string.Empty;
    private string? _comparePrice;
    private string _discount = string.Empty;
    private string _absoluteUrl = string.Empty;
    private string _whatsAppUrl = string.Empty;
    private string _facebookUrl = string.Empty;

    protected override void OnParametersSet()
    {
        _url = ToUrl(StoreUrls.Product(Model.Slug));
        _returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.GetUriWithQueryParameter(StoreUrls.AddedKey, Model.Slug));
        _soldOut = !Model.InStock;
        _addLabel = _soldOut ? Data.SoldOutLabel : Data.AddLabel;
        _shortLabel = _soldOut ? Data.SoldOutLabel : Data.ShortLabel;
        string[] urls = Model.ImageUrls.Count > 0 ? [.. Model.ImageUrls.Take(MaxImages)] : [Model.ImageUrl];
        _images = urls.Select((url, index) => new CardImage(ToUrl(url), index == 0 ? Model.Name : string.Empty, index == 0 ? string.Empty : null)).ToList();
        _badges = BuildBadges();
        _price = FormatMoney(Model.PriceMinor);
        var hasDiscount = Model.CompareAtPriceMinor is { } compare && compare > Model.PriceMinor;
        _comparePrice = hasDiscount ? FormatMoney(Model.CompareAtPriceMinor!.Value) : null;
        _discount = hasDiscount ? $"-{(Model.CompareAtPriceMinor!.Value - Model.PriceMinor) * PercentBase / Model.CompareAtPriceMinor.Value}%" : string.Empty;
        _absoluteUrl = Navigation.ToAbsoluteUri(_url).ToString();
        _whatsAppUrl = $"https://wa.me/?text={Uri.EscapeDataString(Model.Name + " " + _absoluteUrl)}";
        _facebookUrl = $"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(_absoluteUrl)}";
    }

    private List<CardBadge> BuildBadges()
    {
        var badges = new List<CardBadge>();
        if (Model.IsNew)
        {
            badges.Add(new CardBadge(Data.NewLabel, NewBadgeClass));
        }

        if (Model.IsFeatured)
        {
            badges.Add(new CardBadge(Data.FeaturedLabel, NewBadgeClass));
        }

        if (Model.Badge is not null && !string.Equals(Model.Badge, Data.NewLabel, StringComparison.OrdinalIgnoreCase))
        {
            badges.Add(new CardBadge(Model.Badge, PlainBadgeClass));
        }

        if (Model.Kind == ProductKind.Digital)
        {
            badges.Add(new CardBadge(Data.DigitalLabel, PlainBadgeClass));
        }

        return badges;
    }
}
