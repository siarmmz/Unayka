@inject ICatalogQuery Catalog

<section class="container-page py-12 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-14">
        <aside class="space-y-8">
            @foreach (var group in _filterGroups)
            {
                <div>
                    <p class="font-script text-2xl text-clay">@Text(group.Title)</p>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        @foreach (var link in group.Links)
                        {
                            <li><a href="@link.Url" class="@link.CssClass">@Text(link.Label)</a></li>
                        }
                    </ul>
                </div>
            }
        </aside>

        <div>
            <form method="get" action="@_formAction" class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_auto]">
                @foreach (var hidden in _hiddenFields)
                {
                    <input type="hidden" name="@hidden.Name" value="@hidden.Value"/>
                }
                <input type="search" name="@CatalogLinks.QueryKey" value="@_search.Query" placeholder="@Data.SearchPlaceholder" aria-label="@Data.SearchPlaceholder" class="field"/>
                <select name="@CatalogLinks.SortKey" aria-label="@Data.SortLabel" class="field sm:w-56">
                    @foreach (var option in _sortOptions)
                    {
                        <option value="@option.Value" selected="@option.Selected">@Text(option.Label)</option>
                    }
                </select>
                <button type="submit" class="btn-primary">@Text(Data.ApplyLabel)</button>
            </form>

            <p class="mt-6 text-sm text-stone">@Text(_summary)</p>

            @if (_page.Items.Count == 0)
            {
                <div class="mt-10">
                    <EmptyState Title="@Data.EmptyTitle" Message="@Data.EmptyMessage" ActionLabel="@Data.EmptyAction" ActionUrl="@StoreUrls.Shop"/>
                </div>
            }

            @if (_page.Items.Count > 0)
            {
                <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6">
                    @foreach (var item in _page.Items)
                    {
                        <ProductCard Model="item"/>
                    }
                </div>
                <div class="mt-14">
                    <Pagination Page="_page.Page" PageCount="_page.PageCount" BaseUrl="@_paginationBase"/>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const string ChipClass = "inline-flex rounded-full border px-4 py-1.5 text-sm transition";
    private const string ActiveChipClass = ChipClass + " border-espresso bg-espresso text-paper";
    private const string IdleChipClass = ChipClass + " border-sand text-espresso hover:border-clay hover:bg-cream";

    private sealed record FilterLink(string Label, string Url, string CssClass);

    private sealed record FilterGroup(string Title, IReadOnlyList<FilterLink> Links);

    private sealed record SortChoice(string Value, string Label, bool Selected);

    private static readonly (string KindTitle, string AllLabel, string CoffeeLabel, string CosmeticLabel, string CategoryTitle, string PriceTitle, string AnyPriceLabel, string SearchPlaceholder, string SortLabel, string ApplyLabel, string EmptyTitle, string EmptyMessage, string EmptyAction) Data = (
        "Coleção",
        "Tudo",
        "Cafés",
        "Cosméticos",
        "Categorias",
        "Preço",
        "Qualquer preço",
        "Pesquisar produtos",
        "Ordenar por",
        "Aplicar",
        "Nada por aqui",
        "Não encontrámos produtos com estes filtros. Experimente outra pesquisa ou limpe os filtros.",
        "Ver todos os produtos");

    [Parameter, EditorRequired]
    public string BasePath { get; set; } = string.Empty;

    [Parameter]
    public CategoryKind? Kind { get; set; }

    [Parameter]
    public string? CategorySlug { get; set; }

    private ProductSearch _search = new();
    private ProductPage _page = new([], 1, 1, 0);
    private List<FilterGroup> _filterGroups = [];
    private List<SortChoice> _sortOptions = [];
    private IReadOnlyList<(string Name, string Value)> _hiddenFields = [];
    private string _formAction = string.Empty;
    private string _paginationBase = string.Empty;
    private string _summary = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _search = CatalogLinks.Parse(Navigation.Uri, Kind, CategorySlug);
        _page = await Catalog.SearchAsync(_search);
        var categories = await Catalog.CategoriesAsync(Kind);
        _formAction = ToUrl(BasePath);
        _paginationBase = CatalogLinks.Build(BasePath, _search);
        _summary = BuildSummary();
        _hiddenFields = CatalogLinks.PriceFields(_search);
        _sortOptions = CatalogLinks.SortOptions.Select(option => new SortChoice(option.Value, option.Label, option.Sort == _search.Sort)).ToList();
        _filterGroups =
        [
            new FilterGroup(Data.KindTitle, BuildKindLinks()),
            new FilterGroup(Data.CategoryTitle, BuildCategoryLinks(categories)),
            new FilterGroup(Data.PriceTitle, BuildPriceLinks()),
        ];
    }

    private string BuildSummary()
    {
        var count = _page.TotalCount == 1 ? "1 produto" : $"{_page.TotalCount} produtos";
        return string.IsNullOrWhiteSpace(_search.Query) ? count : $"{count} para \"{_search.Query}\"";
    }

    private List<FilterLink> BuildKindLinks()
    {
        var carried = _search with { Page = 1 };
        var noKindSelected = Kind is null && CategorySlug is null;
        return
        [
            new FilterLink(Data.AllLabel, ToUrl(CatalogLinks.Build(StoreUrls.Shop, carried)), ChipFor(noKindSelected)),
            new FilterLink(Data.CoffeeLabel, ToUrl(CatalogLinks.Build(StoreUrls.Coffee, carried)), ChipFor(Kind == CategoryKind.Coffee && CategorySlug is null)),
            new FilterLink(Data.CosmeticLabel, ToUrl(CatalogLinks.Build(StoreUrls.Cosmetics, carried)), ChipFor(Kind == CategoryKind.Cosmetic && CategorySlug is null)),
        ];
    }

    private List<FilterLink> BuildCategoryLinks(IReadOnlyList<CategorySummary> categories) =>
        categories
            .Select(category => new FilterLink(
                $"{category.Name} ({category.ProductCount})",
                ToUrl(CatalogLinks.Build(StoreUrls.Category(category.Slug), _search with { Page = 1 })),
                ChipFor(category.Slug == CategorySlug)))
            .ToList();

    private List<FilterLink> BuildPriceLinks()
    {
        var links = new List<FilterLink>
        {
            new(Data.AnyPriceLabel, ToUrl(CatalogLinks.Build(BasePath, CatalogLinks.WithRange(_search, null))), ChipFor(_search.MinPriceMinor is null && _search.MaxPriceMinor is null)),
        };
        links.AddRange(CatalogLinks.PriceRanges.Select(range => new FilterLink(
            range.Label,
            ToUrl(CatalogLinks.Build(BasePath, CatalogLinks.WithRange(_search, range))),
            ChipFor(CatalogLinks.IsActive(range, _search)))));
        return links;
    }

    private static string ChipFor(bool active) => active ? ActiveChipClass : IdleChipClass;
}
