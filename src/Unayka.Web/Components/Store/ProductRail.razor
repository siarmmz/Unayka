@if (_loops)
{
    <unayka-rail data-loop class="group/swipe relative block">
        <div data-rail-track class="no-scrollbar -mx-4 flex cursor-grab gap-4 overflow-x-auto px-4 pb-4 [mask-image:linear-gradient(to_right,transparent,var(--color-ink)_2rem,var(--color-ink)_calc(100%-2rem),transparent)] data-[dragging]:cursor-grabbing sm:-mx-6 sm:px-6 md:gap-6 lg:-mx-8 lg:px-8">
            @foreach (var item in Items)
            {
                <div class="@CardClass">
                    <StoreProductCard Model="item"/>
                </div>
            }
        </div>
        <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/3 z-20 flex -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-500 animate-swipe-hint group-hover/swipe:animate-none group-hover/swipe:opacity-100 motion-reduce:hidden">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-surface/90 text-2xl text-accent-strong shadow-lg"><i class="bi bi-arrow-left-right animate-swipe-nudge"></i></span>
        </div>
        <button type="button" data-rail-previous aria-label="@Labels.Previous" class="@ArrowClass left-0 -translate-x-1/2"><i class="bi bi-chevron-left"></i></button>
        <button type="button" data-rail-next aria-label="@Labels.Next" class="@ArrowClass right-0 translate-x-1/2"><i class="bi bi-chevron-right"></i></button>
    </unayka-rail>
}
@if (!_loops)
{
    <div class="flex gap-4 md:gap-6">
        @foreach (var item in Items)
        {
            <div class="@CardClass">
                <StoreProductCard Model="item"/>
            </div>
        }
    </div>
}

@code {
    private const int MaxStaticItems = 2;
    private const string CardClass = "w-44 shrink-0 sm:w-52 md:w-60";
    private const string ArrowClass = "absolute top-1/3 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-surface text-accent-strong shadow-md transition hover:scale-110 hover:bg-accent-strong hover:text-surface md:flex";

    private static readonly (string Previous, string Next) Labels = ("Produtos anteriores", "Mais produtos");

    [Parameter, EditorRequired]
    public IReadOnlyList<ProductCardModel> Items { get; set; } = [];

    private bool _loops;

    protected override void OnParametersSet() => _loops = Items.Count > MaxStaticItems;
}
