# Unayka environment configuration.
# Copy this file to .env (git ignored) and fill in the values.
# Real environment variables always win over values in this file.

# Application
# Address the server listens on. Port 10000 is the Docker default.
ASPNETCORE_URLS=http://+:10000
# Development or Production. Production enforces the required variables below.
ASPNETCORE_ENVIRONMENT=Development
# Public address of the site, used for canonical links and webhooks.
APP_PUBLIC_BASE_URL=http://localhost:10000

# Database
# PostgreSQL is used when host and database are both set, otherwise SQLite is used.
DATABASE_POSTGRESQL_CONNECTION_HOST=
DATABASE_POSTGRESQL_CONNECTION_PORT=5432
DATABASE_POSTGRESQL_CONNECTION_DATABASE=
DATABASE_POSTGRESQL_CONNECTION_USER=
DATABASE_POSTGRESQL_CONNECTION_PASSWORD=
# SQLite fallback file, relative to the repository root. Not ignored by Git.
DATABASE_SQLITE_FILE_PATH=database.sqlite

# Image storage
# S3 compatible storage is used when endpoint, bucket and both keys are set and it answers at startup.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Public address used to build image links.
STORAGE_S3_PUBLIC_BASE_URL=
# Local fallback folder, kept outside wwwroot and served by a controlled endpoint.
STORAGE_LOCAL_UPLOADS_PATH=data/uploads
# Folder that keeps the data protection keys (cookies and antiforgery) between restarts.
STORAGE_LOCAL_KEYS_PATH=data/keys

# Payments (PaySuite)
PAYMENT_PAYSUITE_BASE_URL=
PAYMENT_PAYSUITE_API_KEY=
# Secret used to verify webhook signatures.
PAYMENT_PAYSUITE_WEBHOOK_SECRET=
# Estimated gateway fee, only used when the provider does not report the real fee.
PAYMENT_PAYSUITE_FEE_PERCENT=0
# Estimated fixed fee per transaction in MZN.
PAYMENT_PAYSUITE_FEE_FIXED=0
# Phone number that receives payouts of the gateway balance.
PAYMENT_PAYOUT_PHONE=

# Authentication
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# SMS provider used to send login codes.
AUTH_SMS_PROVIDER=
AUTH_SMS_API_KEY=
# Email that receives the Administrator role on first login.
AUTH_ADMIN_BOOTSTRAP_EMAIL=
# Password given to the seeded staff accounts (admin, gerente, caixa). Development only.
# When empty and the environment is not Production, "unayka2026" is used.
# In Production no staff is seeded unless this variable is set.
AUTH_SEED_STAFF_PASSWORD=

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_CHECKOUT_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
